/-! ### The piece table -/

noncomputable def tpiece_dlenDefIntro : V := ⟪(0 : V), vecOf row_dlenDefIntro_as, row_dlenDefIntro_c⟫
noncomputable def tpiece_proofIntro : V := ⟪(0 : V), vecOf row_proofIntro_as, row_proofIntro_c⟫
noncomputable def tpiece_gIntroNum : V := ⟪(0 : V), vecOf row_gIntroNum_as, row_gIntroNum_c⟫
noncomputable def tpiece_lenDerIntro : V := ⟪(0 : V), vecOf row_lenDerIntro_as, row_lenDerIntro_c⟫
noncomputable def tpiece_boxIntro : V := ⟪(0 : V), vecOf row_boxIntro_as, row_boxIntro_c⟫

noncomputable def topExtraPieceList : List V := [
  tpiece_dlenDefIntro,
  tpiece_proofIntro,
  tpiece_gIntroNum,
  tpiece_lenDerIntro,
  tpiece_boxIntro
]

/-- **The piece table of the top**: Frag2's pieces, then the top rows' pieces. -/
noncomputable def topPieces : V := vecOf (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList ++ frag2ExtraPieceList ++ topExtraPieceList)

lemma topPieces_nth_lt (i : ℕ) (hi : i < frag2RowCount) : (topPieces : V).[(i : V)] = (frag2Pieces : V).[(i : V)] := by
  unfold topPieces frag2Pieces
  have h1 : i < (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList ++ frag2ExtraPieceList ++ topExtraPieceList : List V).length := by
    rw [show (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList ++ frag2ExtraPieceList ++ topExtraPieceList : List V).length = topRowCount from rfl]
    exact lt_of_lt_of_le hi (by decide)
  have h2 : i < (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList ++ frag2ExtraPieceList : List V).length := by
    rw [show (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList ++ frag2ExtraPieceList : List V).length = frag2RowCount from rfl]; exact hi
  rw [nth_vecOf _ i h1, nth_vecOf _ i h2]
  exact List.getElem_append_left h2

/-- A Frag2 step read from the top pieces is Frag2's step. -/
lemma mkStep_topPieces_lt (i : ℕ) (hi : i < frag2RowCount) (ev : V) :
    mkStep topPieces (i : V) ev = mkStep frag2Pieces (i : V) ev := by
  rw [mkStep, mkStep, topPieces_nth_lt i hi]

lemma topPieces_dlenDefIntro : (topPieces : V).[((tIdx_dlenDefIntro : ℕ) : V)] = tpiece_dlenDefIntro := by
  unfold topPieces
  rw [nth_vecOf _ tIdx_dlenDefIntro (Nat.lt_of_sub_eq_succ rfl)]
  rfl

lemma tmk_dlenDefIntro (ev : V) :
    mkStep topPieces ((tIdx_dlenDefIntro : ℕ) : V) ev = sUseHorn ((tIdx_dlenDefIntro : ℕ) : V) ev (vecOf row_dlenDefIntro_as) row_dlenDefIntro_c := by
  rw [mkStep, topPieces_dlenDefIntro]
  simp [tpiece_dlenDefIntro, sUseHorn]

lemma ttag_dlenDefIntro {W : V} (hWp : W = topPieces) (ev : V) : sTag (mkStep W (150 : V) ev) = 0 := by
