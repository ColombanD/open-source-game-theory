  ⟨4, boxIntroB, lib_boxIntro⟩
]

/-- The top table's rows: Frag2's, then the five top rows. -/
noncomputable def topRows : List WRow := frag2Rows ++ topExtraRows

lemma topRows_length : topRows.length = topRowCount := rfl

/-- **The top proof table**: `topRowCount` rows at least, the `i`-th with the arity and the matrix of
`topRows[i]`. -/
def TopTable (tbl : V) : Prop :=
  (topRowCount : V) ≤ len tbl ∧
  ∀ (i : ℕ) (h : i < topRows.length),
    rowM tbl.[(i : V)] = ((topRows[i]).m : V) ∧ rowB tbl.[(i : V)] = ⌜Semiformula.lMap emb (topRows[i]).B⌝

/-- A top table is a fragment-2 table (the first 150 rows). -/
lemma TopTable.frag2Table {tbl : V} (h : TopTable tbl) : Frag2Table tbl := by
  refine ⟨le_trans (by exact_mod_cast (by decide : frag2RowCount ≤ topRowCount)) h.1, ?_⟩
  intro i hi
  have hi' : i < topRows.length := by
    rw [topRows_length]; exact lt_of_lt_of_le (frag2Rows_length ▸ hi) (by decide)
  have := h.2 i hi'
  rwa [show topRows[i] = frag2Rows[i] from List.getElem_append_left hi] at this

lemma TopTable.frag1Table {tbl : V} (h : TopTable tbl) : Frag1Table tbl := h.frag2Table.frag1Table
lemma TopTable.layoutTable {tbl : V} (h : TopTable tbl) : LayoutTable tbl := h.frag2Table.layoutTable
lemma TopTable.walkTable {tbl : V} (h : TopTable tbl) : WalkTable tbl := h.frag2Table.walkTable

/-- **The top proof table exists in every model, with one standard length bound.** -/
theorem exists_topTable : ∃ N : ℕ, ∀ (V : Type) [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁],
    ∃ tbl : V, TableOK tbl (N : V) ∧ TopTable tbl := by
  obtain ⟨N, hN⟩ := exists_rows topRows
  refine ⟨N, fun V _ _ ↦ ?_⟩
  obtain ⟨rows, hlen, hok, hidx⟩ := hN V
  refine ⟨vecOf rows, tableOK_vecOf rows hok, ?_, ?_⟩
  · rw [len_vecOf, hlen, topRows_length]
  · intro i h
    have h' : i < rows.length := by rw [hlen]; exact h
    rw [nth_vecOf rows i h']
    exact hidx i h h'

lemma topTable_len {tbl : V} (h : TopTable tbl) (i : ℕ) (hi : i < topRowCount) : ((i : ℕ) : V) < len tbl :=
  lt_of_lt_of_le (by exact_mod_cast hi) h.1

/-! ### The per-row readings of `TopTable` -/

lemma topTable_dlenDefIntro {tbl : V} (h : TopTable tbl) :
    rowM tbl.[((tIdx_dlenDefIntro : ℕ) : V)] = ((2 : ℕ) : V) ∧
    rowB tbl.[((tIdx_dlenDefIntro : ℕ) : V)] = impChainV LAct (vecOf row_dlenDefIntro_as) row_dlenDefIntro_c := by
  have this : rowM tbl.[((tIdx_dlenDefIntro : ℕ) : V)] = ((2 : ℕ) : V) ∧
      rowB tbl.[((tIdx_dlenDefIntro : ℕ) : V)] = ⌜Semiformula.lMap emb dlenDefIntroB⌝ :=
    h.2 tIdx_dlenDefIntro (Nat.lt_of_sub_eq_succ rfl)
  refine ⟨this.1, ?_⟩
  rw [impChainV_vecOf, this.2, quote_row_dlenDefIntro]

