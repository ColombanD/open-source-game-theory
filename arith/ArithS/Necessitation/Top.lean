  have hstep := tmk_lenDerIntro (V := V) ?[wd, wn, wg, wa]
  have hlen := topTable_len hT tIdx_lenDerIntro (by decide)
  have hrow := topTable_lenDerIntro hT
  rw [hk] at hstep hlen hrow
  have hes : ∀ e ∈ [wd, wn, wg, wa], IsSemiterm LAct 0 e ∧ termLen LAct e ≤ E := List.forall_mem_cons.mpr ⟨⟨hwd, hEwd⟩, List.forall_mem_cons.mpr ⟨⟨hwn, hEwn⟩, List.forall_mem_cons.mpr ⟨⟨hwg, hEwg⟩, List.forall_mem_cons.mpr ⟨⟨hwa, hEwa⟩, List.forall_mem_nil _⟩⟩⟩⟩
  have hinst := inst_lenDerIntro hwd hwn hwg hwa
  rw [hstep, show (?[wd, wn, wg, wa] : V) = vecOf [wd, wn, wg, wa] from rfl]
  refine ⟨stepOK_useHorn htbl [wd, wn, wg, wa] row_lenDerIntro_as hΓ hlen hrow.1 hrow.2 (by exact_mod_cast (by decide : 4 ≤ 8))
    (by rw [show row_lenDerIntro_as.length = 3 from rfl] <;> exact_mod_cast (by decide : 3 ≤ 8)) hes ?_, by simp, ?_⟩
  · exact neg_mem_of_map hinst.1 (List.forall_mem_cons.mpr ⟨hmem0, List.forall_mem_cons.mpr ⟨hmem1, List.forall_mem_cons.mpr ⟨hmem2, List.forall_mem_nil _⟩⟩⟩)
  · rw [ctxAfter_useHorn [wd, wn, wg, wa] row_lenDerIntro_as isSemiformula_lenDerIntro_c (fun e he ↦ (hes e he).1), hinst.2]

/-- Row `boxIntro` as a step. -/
lemma tok_boxIntro {tbl N E Γ W : V} {wa wg wk wn : V} (htbl : TableOK tbl N) (hT : TopTable tbl) (hWp : W = topPieces)
    (hΓ : IsFormulaSet LAct Γ) (hwa : IsSemiterm LAct 0 wa) (hEwa : termLen LAct wa ≤ E) (hwg : IsSemiterm LAct 0 wg) (hEwg : termLen LAct wg ≤ E) (hwk : IsSemiterm LAct 0 wk) (hEwk : termLen LAct wk ≤ E) (hwn : IsSemiterm LAct 0 wn) (hEwn : termLen LAct wn ≤ E) (hmem0 : neg LAct (gFact wa wk) ∈ Γ) (hmem1 : neg LAct (instBFact wg wn wk) ∈ Γ) (hmem2 : neg LAct (lenDerFact wa wg) ∈ Γ) :
    StepOK tbl E ((8 : ℕ) : V) Γ (mkStep W 154 ?[wa, wg, wk, wn]) ∧ sTag (mkStep W 154 ?[wa, wg, wk, wn]) = 0 ∧
    ctxAfter Γ (mkStep W 154 ?[wa, wg, wk, wn]) = insert (neg LAct (boxFact wn wk)) Γ := by
  subst hWp
  have hk : ((tIdx_boxIntro : ℕ) : V) = (154 : V) := by simp [tIdx_boxIntro]
  have hstep := tmk_boxIntro (V := V) ?[wa, wg, wk, wn]
  have hlen := topTable_len hT tIdx_boxIntro (by decide)
  have hrow := topTable_boxIntro hT
  rw [hk] at hstep hlen hrow
  have hes : ∀ e ∈ [wa, wg, wk, wn], IsSemiterm LAct 0 e ∧ termLen LAct e ≤ E := List.forall_mem_cons.mpr ⟨⟨hwa, hEwa⟩, List.forall_mem_cons.mpr ⟨⟨hwg, hEwg⟩, List.forall_mem_cons.mpr ⟨⟨hwk, hEwk⟩, List.forall_mem_cons.mpr ⟨⟨hwn, hEwn⟩, List.forall_mem_nil _⟩⟩⟩⟩
  have hinst := inst_boxIntro hwa hwg hwk hwn
  rw [hstep, show (?[wa, wg, wk, wn] : V) = vecOf [wa, wg, wk, wn] from rfl]
  refine ⟨stepOK_useHorn htbl [wa, wg, wk, wn] row_boxIntro_as hΓ hlen hrow.1 hrow.2 (by exact_mod_cast (by decide : 4 ≤ 8))
    (by rw [show row_boxIntro_as.length = 3 from rfl] <;> exact_mod_cast (by decide : 3 ≤ 8)) hes ?_, by simp, ?_⟩
  · exact neg_mem_of_map hinst.1 (List.forall_mem_cons.mpr ⟨hmem0, List.forall_mem_cons.mpr ⟨hmem1, List.forall_mem_cons.mpr ⟨hmem2, List.forall_mem_nil _⟩⟩⟩)
  · rw [ctxAfter_useHorn [wa, wg, wk, wn] row_boxIntro_as isSemiformula_boxIntro_c (fun e he ↦ (hes e he).1), hinst.2]

/-! ### The Frag1 row `leTrans` (110), read from the top pieces -/

lemma tfok_leTrans {tbl N E Γ W : V} {wz wy wx : V} (htbl : TableOK tbl N) (hT : TopTable tbl) (hWp : W = topPieces)
    (hΓ : IsFormulaSet LAct Γ) (hwz : IsSemiterm LAct 0 wz) (hEwz : termLen LAct wz ≤ E) (hwy : IsSemiterm LAct 0 wy) (hEwy : termLen LAct wy ≤ E) (hwx : IsSemiterm LAct 0 wx) (hEwx : termLen LAct wx ≤ E) (hmem0 : neg LAct (leFact wx wy) ∈ Γ) (hmem1 : neg LAct (leFact wy wz) ∈ Γ) :
    StepOK tbl E ((8 : ℕ) : V) Γ (mkStep W 110 ?[wz, wy, wx]) ∧ sTag (mkStep W 110 ?[wz, wy, wx]) = 0 ∧
    ctxAfter Γ (mkStep W 110 ?[wz, wy, wx]) = insert (neg LAct (leFact wx wz)) Γ := by
  subst hWp
  have e : ∀ ev : V, mkStep topPieces (110 : V) ev = mkStep frag1Pieces (110 : V) ev := fun ev ↦ by
    have h1 := mkStep_topPieces_lt 110 (by decide) ev
    have h2 := mkStep_frag2Pieces_lt 110 (by decide) ev
    simp only [Nat.cast_ofNat] at h1 h2; rw [h1, h2]
  rw [e]
  exact fok_leTrans htbl hT.frag1Table rfl hΓ hwz hEwz hwy hEwy hwx hEwx hmem0 hmem1

end topTable

/-! ## 2. The target's code shape (for a VARIABLE `χ` — no closed quote is ever unfolded) -/

section targetShape

noncomputable def qNum (χ : Semisentence LAct 1) : V := numeral (⌜χ⌝ : V)

lemma isSemiterm_qNum (χ : Semisentence LAct 1) : IsSemiterm LAct (0 : V) (qNum χ) :=
  InstV.isSemiterm_LAct_of_LOR (numeral_semiterm 0 _)

theorem quote_Box_g (χ : Semisentence LAct 1) :
    (⌜Box_g χ⌝ : V) = subst LAct (qNum χ ∷ ^#0 ∷ 0) Pbox := by
  rw [Box_g_def]
  conv_lhs =>
    rw [Sentence.quote_def, Semiformula.coe_subst_eq_subst_coe, Semiformula.quote_def,
      Semiformula.typed_quote_substs, Bootstrapping.Semiformula.val_substs, ← Semiformula.quote_def,
      ← Sentence.quote_def]
  unfold Pbox
  congr 1
  have hv : (fun i ↦ (⌜(Rew.emb (![Semiterm.lMap emb (⌜χ⌝ : ArithmeticSemiterm Empty 1), #0] i) :
      SyntacticSemiterm LAct 1)⌝ : Bootstrapping.Semiterm V LAct 1)) =
      ![⌜(Rew.emb (Semiterm.lMap emb (⌜χ⌝ : ArithmeticSemiterm Empty 1)) : SyntacticSemiterm LAct 1)⌝,
        ⌜(Rew.emb (#0 : Semiterm LAct Empty 1) : SyntacticSemiterm LAct 1)⌝] := by
    funext i; fin_cases i <;> rfl
  rw [hv]
  simp only [SemitermVec.val_cons, SemitermVec.val_nil, Diag.typed_val_emb, quote_lMap_gödel]
  rfl

lemma termShift_numeral_LAct (x : V) : termShift LAct (numeral x) = numeral x := by
  induction x using ISigma1.sigma1_succ_induction
  · definability
  case zero => rw [numeral_zero, termShift_qqZero isFunc_LAct_zeroIndex]
  case succ x ih =>
    rcases zero_or_succ x with (rfl | ⟨x, rfl⟩)
    · rw [zero_add, numeral_one, termShift_qqOne isFunc_LAct_oneIndex]
    · rw [numeral_add_two, termShift_qqAdd isFunc_LAct_addIndex
        (InstV.isSemiterm_LAct_of_LOR (numeral_semiterm 0 _)).isUTerm qqOne_uterm_LAct, ih,
        termShift_qqOne isFunc_LAct_oneIndex]

lemma termLen_numeral_le (x : V) : termLen LAct (numeral x) ≤ 2 * x + 1 := by
  induction x using ISigma1.sigma1_succ_induction
  · definability
  case zero => rw [numeral_zero, termLen_qqZero isFunc_LAct_zeroIndex]; simp
  case succ x ih =>
    rcases zero_or_succ x with (rfl | ⟨x, rfl⟩)
    · rw [zero_add, numeral_one, termLen_qqOne isFunc_LAct_oneIndex]; simp
    · rw [numeral_add_two, termLen_qqAdd isFunc_LAct_addIndex
        (InstV.isSemiterm_LAct_of_LOR (numeral_semiterm 0 _)).isUTerm qqOne_uterm_LAct,
        termLen_qqOne isFunc_LAct_oneIndex]
      calc termLen LAct (numeral (x + 1)) + 1 + 1 ≤ 2 * (x + 1) + 1 + 1 + 1 := by
            exact add_le_add (add_le_add ih le_rfl) le_rfl
        _ = 2 * (x + 1 + 1) + 1 := by ring

theorem instB_quote_Box_g (χ : Semisentence LAct 1) (k : V) :
    instB (⌜Box_g χ⌝ : V) k = subst LAct (qNum χ ∷ bnum k ∷ 0) Pbox := by
  rw [quote_Box_g, instB]
  have hq : IsSemiterm LAct ((0 : V) + 1) (qNum χ) := InstV.isSemiterm_LAct_of_LOR (numeral_semiterm ((0 : V) + 1) _)
  have hb : IsSemiterm LAct ((0 : V) + 1) (^#0 : V) := by simp
  have hv : IsSemitermVec LAct ((0 : V) + 1 + 1) ((0 : V) + 1) (qNum χ ∷ ^#0 ∷ (0 : V)) :=
    IsSemitermVec.adjoin (IsSemitermVec.adjoin (IsSemitermVec.nil (L := LAct) ((0 : V) + 1)) hb) hq
  have hw : IsSemitermVec LAct ((0 : V) + 1) (0 : V) (bnum k ∷ (0 : V)) :=
    IsSemitermVec.adjoin (IsSemitermVec.nil (L := LAct) (0 : V)) (bnum_term_LAct k)
  have h2 : ((2 : ℕ) : V) = 0 + 1 + 1 := by simp [one_add_one_eq_two]
  rw [substs_substs (h2 ▸ isSemiformula_Pbox) hw hv]
  congr 1
  rw [termSubstVec_cons hq.isUTerm (IsSemitermVec.adjoin (IsSemitermVec.nil (L := LAct) ((0 : V) + 1)) hb).isUTerm,
    termSubstVec_cons hb.isUTerm (IsSemitermVec.nil (L := LAct) ((0 : V) + 1)).isUTerm, termSubstVec_nil, termSubst_bvar,
    termSubst_eq_self (L := LAct) (w := bnum k ∷ (0 : V)) (isSemiterm_qNum χ) (fun i hi ↦ by simp at hi)]
  simp


/-- **The target IS the `boxIntro` fact**: `instB ⌜Box_g χ⌝ k = boxFact (qNum χ) (bnum k)`. -/
theorem target_eq_boxFact (χ : Semisentence LAct 1) (k : V) :
    instB (⌜Box_g χ⌝ : V) k = boxFact (qNum χ) (bnum k) :=
  instB_quote_Box_g χ k

lemma termShift_qNum (χ : Semisentence LAct 1) : termShift LAct (qNum χ : V) = qNum χ :=
  termShift_numeral_LAct _

/-- The numeral's length is a STANDARD constant of `χ`: `≤ 2·⌜χ⌝ + 1` with `⌜χ⌝ : ℕ` cast. -/
lemma termLen_qNum_le (χ : Semisentence LAct 1) :
    termLen LAct (qNum χ : V) ≤ ((2 * (⌜χ⌝ : ℕ) + 1 : ℕ) : V) := by
  unfold qNum
  push_cast
  rw [Sentence.coe_quote_eq_quote χ]
  exact termLen_numeral_le _

end targetShape

end ArithS
