  rw [hk] at hstep hlen hrow
  have hes : ∀ e ∈ [ws, wg, wd], IsSemiterm LAct 0 e ∧ termLen LAct e ≤ E := List.forall_mem_cons.mpr ⟨⟨hws, hEws⟩, List.forall_mem_cons.mpr ⟨⟨hwg, hEwg⟩, List.forall_mem_cons.mpr ⟨⟨hwd, hEwd⟩, List.forall_mem_nil _⟩⟩⟩
  have hinst := inst_proofIntro hws hwg hwd
  rw [hstep, show (?[ws, wg, wd] : V) = vecOf [ws, wg, wd] from rfl]
  refine ⟨stepOK_useHorn htbl [ws, wg, wd] row_proofIntro_as hΓ hlen hrow.1 hrow.2 (by exact_mod_cast (by decide : 3 ≤ 8))
    (by rw [show row_proofIntro_as.length = 3 from rfl] <;> exact_mod_cast (by decide : 3 ≤ 8)) hes ?_, by simp, ?_⟩
  · exact neg_mem_of_map hinst.1 (List.forall_mem_cons.mpr ⟨hmem0, List.forall_mem_cons.mpr ⟨hmem1, List.forall_mem_cons.mpr ⟨hmem2, List.forall_mem_nil _⟩⟩⟩)
  · rw [ctxAfter_useHorn [ws, wg, wd] row_proofIntro_as isSemiformula_proofIntro_c (fun e he ↦ (hes e he).1), hinst.2]

/-- Row `gIntroNum` as a step. -/
lemma tok_gIntroNum {tbl N E Γ W : V} {wk wl wb wa : V} (htbl : TableOK tbl N) (hT : TopTable tbl) (hWp : W = topPieces)
    (hΓ : IsFormulaSet LAct Γ) (hwk : IsSemiterm LAct 0 wk) (hEwk : termLen LAct wk ≤ E) (hwl : IsSemiterm LAct 0 wl) (hEwl : termLen LAct wl ≤ E) (hwb : IsSemiterm LAct 0 wb) (hEwb : termLen LAct wb ≤ E) (hwa : IsSemiterm LAct 0 wa) (hEwa : termLen LAct wa ≤ E) (hmem0 : neg LAct (lengthFact wl wk) ∈ Γ) (hmem1 : neg LAct (eqFactB (wl ^* wl) wb) ∈ Γ) (hmem2 : neg LAct (eqFactB (wb ^* wl) wa) ∈ Γ) :
    StepOK tbl E ((8 : ℕ) : V) Γ (mkStep W 152 ?[wk, wl, wb, wa]) ∧ sTag (mkStep W 152 ?[wk, wl, wb, wa]) = 0 ∧
    ctxAfter Γ (mkStep W 152 ?[wk, wl, wb, wa]) = insert (neg LAct (gFact wa wk)) Γ := by
