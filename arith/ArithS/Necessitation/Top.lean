    instOuter LAct [wk, wl, wb, wa] row_gIntroNum_c = gFact wa wk := by
  have hes : ∀ e ∈ ([wk, wl, wb, wa] : List V), IsSemiterm LAct 0 e := (List.forall_mem_cons.mpr ⟨hwk, List.forall_mem_cons.mpr ⟨hwl, List.forall_mem_cons.mpr ⟨hwb, List.forall_mem_cons.mpr ⟨hwa, List.forall_mem_nil _⟩⟩⟩⟩)
  unfold row_gIntroNum_as row_gIntroNum_c
