  have hstep := tmk_gIntroNum (V := V) ?[wk, wl, wb, wa]
  have hlen := topTable_len hT tIdx_gIntroNum (by decide)
  have hrow := topTable_gIntroNum hT
  rw [hk] at hstep hlen hrow
  have hes : ∀ e ∈ [wk, wl, wb, wa], IsSemiterm LAct 0 e ∧ termLen LAct e ≤ E := List.forall_mem_cons.mpr ⟨⟨hwk, hEwk⟩, List.forall_mem_cons.mpr ⟨⟨hwl, hEwl⟩, List.forall_mem_cons.mpr ⟨⟨hwb, hEwb⟩, List.forall_mem_cons.mpr ⟨⟨hwa, hEwa⟩, List.forall_mem_nil _⟩⟩⟩⟩
  have hinst := inst_gIntroNum hwk hwl hwb hwa
  rw [hstep, show (?[wk, wl, wb, wa] : V) = vecOf [wk, wl, wb, wa] from rfl]
  refine ⟨stepOK_useHorn htbl [wk, wl, wb, wa] row_gIntroNum_as hΓ hlen hrow.1 hrow.2 (by exact_mod_cast (by decide : 4 ≤ 8))
    (by rw [show row_gIntroNum_as.length = 3 from rfl] <;> exact_mod_cast (by decide : 3 ≤ 8)) hes ?_, by simp, ?_⟩
  · exact neg_mem_of_map hinst.1 (List.forall_mem_cons.mpr ⟨hmem0, List.forall_mem_cons.mpr ⟨hmem1, List.forall_mem_cons.mpr ⟨hmem2, List.forall_mem_nil _⟩⟩⟩)
  · rw [ctxAfter_useHorn [wk, wl, wb, wa] row_gIntroNum_as isSemiformula_gIntroNum_c (fun e he ↦ (hes e he).1), hinst.2]

/-- Row `lenDerIntro` as a step. -/
lemma tok_lenDerIntro {tbl N E Γ W : V} {wd wn wg wa : V} (htbl : TableOK tbl N) (hT : TopTable tbl) (hWp : W = topPieces)
    (hΓ : IsFormulaSet LAct Γ) (hwd : IsSemiterm LAct 0 wd) (hEwd : termLen LAct wd ≤ E) (hwn : IsSemiterm LAct 0 wn) (hEwn : termLen LAct wn ≤ E) (hwg : IsSemiterm LAct 0 wg) (hEwg : termLen LAct wg ≤ E) (hwa : IsSemiterm LAct 0 wa) (hEwa : termLen LAct wa ≤ E) (hmem0 : neg LAct (proofFact wd wg) ∈ Γ) (hmem1 : neg LAct (dlenDefFact wn wd) ∈ Γ) (hmem2 : neg LAct (leFact wn wa) ∈ Γ) :
    StepOK tbl E ((8 : ℕ) : V) Γ (mkStep W 153 ?[wd, wn, wg, wa]) ∧ sTag (mkStep W 153 ?[wd, wn, wg, wa]) = 0 ∧
    ctxAfter Γ (mkStep W 153 ?[wd, wn, wg, wa]) = insert (neg LAct (lenDerFact wa wg)) Γ := by
  subst hWp
