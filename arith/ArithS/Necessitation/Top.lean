/-! ### The per-row applicability lemmas `tok_<row>` -/

/-- Row `dlenDefIntro` as a step. -/
lemma tok_dlenDefIntro {tbl N E Γ W : V} {wd wn : V} (htbl : TableOK tbl N) (hT : TopTable tbl) (hWp : W = topPieces)
    (hΓ : IsFormulaSet LAct Γ) (hwd : IsSemiterm LAct 0 wd) (hEwd : termLen LAct wd ≤ E) (hwn : IsSemiterm LAct 0 wn) (hEwn : termLen LAct wn ≤ E) (hmem0 : neg LAct (derFact wd) ∈ Γ) (hmem1 : neg LAct (dlenFact wd wn) ∈ Γ) :
    StepOK tbl E ((8 : ℕ) : V) Γ (mkStep W 150 ?[wd, wn]) ∧ sTag (mkStep W 150 ?[wd, wn]) = 0 ∧
    ctxAfter Γ (mkStep W 150 ?[wd, wn]) = insert (neg LAct (dlenDefFact wn wd)) Γ := by
  subst hWp
  have hk : ((tIdx_dlenDefIntro : ℕ) : V) = (150 : V) := by simp [tIdx_dlenDefIntro]
  have hstep := tmk_dlenDefIntro (V := V) ?[wd, wn]
  have hlen := topTable_len hT tIdx_dlenDefIntro (by decide)
  have hrow := topTable_dlenDefIntro hT
  rw [hk] at hstep hlen hrow
  have hes : ∀ e ∈ [wd, wn], IsSemiterm LAct 0 e ∧ termLen LAct e ≤ E := List.forall_mem_cons.mpr ⟨⟨hwd, hEwd⟩, List.forall_mem_cons.mpr ⟨⟨hwn, hEwn⟩, List.forall_mem_nil _⟩⟩
  have hinst := inst_dlenDefIntro hwd hwn
  rw [hstep, show (?[wd, wn] : V) = vecOf [wd, wn] from rfl]
  refine ⟨stepOK_useHorn htbl [wd, wn] row_dlenDefIntro_as hΓ hlen hrow.1 hrow.2 (by exact_mod_cast (by decide : 2 ≤ 8))
    (by rw [show row_dlenDefIntro_as.length = 2 from rfl] <;> exact_mod_cast (by decide : 2 ≤ 8)) hes ?_, by simp, ?_⟩
  · exact neg_mem_of_map hinst.1 (List.forall_mem_cons.mpr ⟨hmem0, List.forall_mem_cons.mpr ⟨hmem1, List.forall_mem_nil _⟩⟩)
  · rw [ctxAfter_useHorn [wd, wn] row_dlenDefIntro_as isSemiformula_dlenDefIntro_c (fun e he ↦ (hes e he).1), hinst.2]

/-- Row `proofIntro` as a step. -/
lemma tok_proofIntro {tbl N E Γ W : V} {ws wg wd : V} (htbl : TableOK tbl N) (hT : TopTable tbl) (hWp : W = topPieces)
    (hΓ : IsFormulaSet LAct Γ) (hws : IsSemiterm LAct 0 ws) (hEws : termLen LAct ws ≤ E) (hwg : IsSemiterm LAct 0 wg) (hEwg : termLen LAct wg ≤ E) (hwd : IsSemiterm LAct 0 wd) (hEwd : termLen LAct wd ≤ E) (hmem0 : neg LAct (insFact ws wg (𝟎 : V)) ∈ Γ) (hmem1 : neg LAct (fstIdxFact ws wd) ∈ Γ) (hmem2 : neg LAct (derFact wd) ∈ Γ) :
    StepOK tbl E ((8 : ℕ) : V) Γ (mkStep W 151 ?[ws, wg, wd]) ∧ sTag (mkStep W 151 ?[ws, wg, wd]) = 0 ∧
    ctxAfter Γ (mkStep W 151 ?[ws, wg, wd]) = insert (neg LAct (proofFact wd wg)) Γ := by
  subst hWp
  have hk : ((tIdx_proofIntro : ℕ) : V) = (151 : V) := by simp [tIdx_proofIntro]
  have hstep := tmk_proofIntro (V := V) ?[ws, wg, wd]
  have hlen := topTable_len hT tIdx_proofIntro (by decide)
