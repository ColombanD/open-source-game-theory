/-! ## 1. The rows, the table and the pieces (GENERATED — `gen_top.py` on the `gen_frag2.py` template) -/

/-! ### The two new predicate codes: `lenDerivableDef TAct` and `boxCore` -/

/-- `boxCore` as a Σ₁ symbol (an `∃` over two Σ₁ graphs), so that the DSL `!boxCoreS n k` reads through a
`Defined` instance (the `bewB` route) and `simp` never unfolds it under a substitution. -/
noncomputable def boxCoreS : 𝚺₁.Semisentence 2 := .mkSigma “n k. ∃ a, !gGraph a k ∧ !bewBDef a n k”

lemma boxCoreS_val : ((boxCoreS : 𝚺₁.Semisentence 2) : Semisentence ℒₒᵣ 2) = boxCore := rfl

/-- The relation the box core defines: `n k ↦ LenDerivable TAct (gBudget k) (instB n k)` (`eval_boxCore`). -/
def boxRel (n k : V) : Prop := LenDerivable TAct (gBudget k) (instB n k)

instance boxRel.defined : 𝚺₁-Relation[V] boxRel via boxCoreS := .mk fun v ↦ by
  simp [boxCoreS, boxRel, bewB]

/-- The code of `lenDer` (arity 2). -/
noncomputable def PlenDer : V := ⌜Semiformula.lMap emb (↑(lenDerivableDef TAct) : ArithmeticSemisentence 2)⌝
lemma isSemiformula_PlenDer : IsSemiformula LAct ((2 : ℕ) : V) (PlenDer : V) := Sentence.quote_isSemiformula _
lemma shift_PlenDer : shift LAct (PlenDer : V) = PlenDer := shift_quote_sentence _
lemma fvOccF_PlenDer : fvOccF LAct (PlenDer : V) = 0 := fvOccF_quote_sentence _

/-- The code of `box` (arity 2). -/
noncomputable def Pbox : V := ⌜Semiformula.lMap emb (↑boxCoreS : ArithmeticSemisentence 2)⌝
lemma isSemiformula_Pbox : IsSemiformula LAct ((2 : ℕ) : V) (Pbox : V) := Sentence.quote_isSemiformula _
lemma shift_Pbox : shift LAct (Pbox : V) = Pbox := shift_quote_sentence _
lemma fvOccF_Pbox : fvOccF LAct (Pbox : V) = 0 := fvOccF_quote_sentence _

noncomputable def lenDerFact (a g : V) : V := subst LAct (listToVec [a, g]) PlenDer
lemma isFormula_lenDerFact {a g : V} (ha : IsSemiterm LAct 0 a) (hg : IsSemiterm LAct 0 g) : IsFormula LAct (lenDerFact a g) :=
  isFormula_fact isSemiformula_PlenDer _ rfl (List.forall_mem_cons.mpr ⟨ha, List.forall_mem_cons.mpr ⟨hg, List.forall_mem_nil _⟩⟩)
lemma shift_lenDerFact {a g : V} (ha : IsSemiterm LAct 0 a) (hg : IsSemiterm LAct 0 g) :
    shift LAct (lenDerFact a g) = lenDerFact (termShift LAct a) (termShift LAct g) := by
  unfold lenDerFact
  rw [shift_subst_listToVec [a, g] isSemiformula_PlenDer shift_PlenDer (n := 0) (List.forall_mem_cons.mpr ⟨ha, List.forall_mem_cons.mpr ⟨hg, List.forall_mem_nil _⟩⟩)]
  rfl
lemma formulaLen_lenDerFact_le {B : V} (hB : 1 ≤ B) {a g : V} (ha : IsSemiterm LAct 0 a) (hg : IsSemiterm LAct 0 g) (hla : termLen LAct a ≤ B) (hlg : termLen LAct g ≤ B) :
    formulaLen LAct (lenDerFact a g) ≤ formulaLen LAct (PlenDer : V) * B :=
  formulaLen_fact_le hB isSemiformula_PlenDer _ rfl (List.forall_mem_cons.mpr ⟨⟨ha, hla⟩, List.forall_mem_cons.mpr ⟨⟨hg, hlg⟩, List.forall_mem_nil _⟩⟩)
lemma fvOccF_lenDerFact_le {M : V} {a g : V} (ha : IsSemiterm LAct 0 a) (hg : IsSemiterm LAct 0 g) (hoa : fvOcc LAct a ≤ M) (hog : fvOcc LAct g ≤ M) :
    fvOccF LAct (lenDerFact a g) ≤ bvOccF LAct (PlenDer : V) * M :=
  fvOccF_fact_le isSemiformula_PlenDer fvOccF_PlenDer _ rfl (List.forall_mem_cons.mpr ⟨⟨ha, hoa⟩, List.forall_mem_cons.mpr ⟨⟨hg, hog⟩, List.forall_mem_nil _⟩⟩)

noncomputable def boxFact (n k : V) : V := subst LAct (listToVec [n, k]) Pbox
lemma isFormula_boxFact {n k : V} (hn : IsSemiterm LAct 0 n) (hk : IsSemiterm LAct 0 k) : IsFormula LAct (boxFact n k) :=
  isFormula_fact isSemiformula_Pbox _ rfl (List.forall_mem_cons.mpr ⟨hn, List.forall_mem_cons.mpr ⟨hk, List.forall_mem_nil _⟩⟩)
lemma shift_boxFact {n k : V} (hn : IsSemiterm LAct 0 n) (hk : IsSemiterm LAct 0 k) :
    shift LAct (boxFact n k) = boxFact (termShift LAct n) (termShift LAct k) := by
  unfold boxFact
  rw [shift_subst_listToVec [n, k] isSemiformula_Pbox shift_Pbox (n := 0) (List.forall_mem_cons.mpr ⟨hn, List.forall_mem_cons.mpr ⟨hk, List.forall_mem_nil _⟩⟩)]
  rfl
lemma formulaLen_boxFact_le {B : V} (hB : 1 ≤ B) {n k : V} (hn : IsSemiterm LAct 0 n) (hk : IsSemiterm LAct 0 k) (hln : termLen LAct n ≤ B) (hlk : termLen LAct k ≤ B) :
    formulaLen LAct (boxFact n k) ≤ formulaLen LAct (Pbox : V) * B :=
  formulaLen_fact_le hB isSemiformula_Pbox _ rfl (List.forall_mem_cons.mpr ⟨⟨hn, hln⟩, List.forall_mem_cons.mpr ⟨⟨hk, hlk⟩, List.forall_mem_nil _⟩⟩)
lemma fvOccF_boxFact_le {M : V} {n k : V} (hn : IsSemiterm LAct 0 n) (hk : IsSemiterm LAct 0 k) (hon : fvOcc LAct n ≤ M) (hok : fvOcc LAct k ≤ M) :
    fvOccF LAct (boxFact n k) ≤ bvOccF LAct (Pbox : V) * M :=
  fvOccF_fact_le isSemiformula_Pbox fvOccF_Pbox _ rfl (List.forall_mem_cons.mpr ⟨⟨hn, hon⟩, List.forall_mem_cons.mpr ⟨⟨hk, hok⟩, List.forall_mem_nil _⟩⟩)

/-! ### The three new library rows (`Lib`), on the `Lib/Frag.lean` template -/

/-- `l = ‖k‖ → l * l = b → b * l = a → a = gBudget k` (the cube through two numeral products, §7.1 step 8). -/
noncomputable def gIntroNumB : ArithmeticSemisentence 4 :=
  “a b l k. !lengthDef l k → (l * l) = b → (b * l) = a → !gGraph a k”
noncomputable def gIntroNum : ArithmeticSentence := ∀¹* gIntroNumB
lemma models_gIntroNum : V↓[ℒₒᵣ] ⊧ gIntroNum ↔ ∀ a b l k : V, l = ‖k‖ → (l * l) = b → (b * l) = a → a = gBudget k := by
  simp [gIntroNum, gIntroNumB, models_iff, Matrix.vecForall_iff, length_defined.iff, gBudget.defined.iff]
theorem pa_proves_gIntroNum : 𝗣𝗔 ⊢ gIntroNum :=
  Lib.pa_proves_of_models fun _ _ _ ↦ models_gIntroNum.mpr fun _ _ _ _ h1 h2 h3 ↦ by subst_vars; first | rfl | assumption | trivial
theorem lib_gIntroNum : Lib gIntroNum := Lib.of_pa pa_proves_gIntroNum

/-- `proof d g → n = dlen d → n ≤ a → LenDerivable a g` (§7.1 step 7, folded). -/
noncomputable def lenDerIntroB : ArithmeticSemisentence 4 :=
  “a g n d. !(proof TAct).sigma d g → !(dlenDef TAct) n d → n ≤ a → !(lenDerivableDef TAct) a g”
noncomputable def lenDerIntro : ArithmeticSentence := ∀¹* lenDerIntroB
lemma models_lenDerIntro : V↓[ℒₒᵣ] ⊧ lenDerIntro ↔ ∀ a g n d : V, Proof TAct d g → n = dlen TAct d → n ≤ a → LenDerivable TAct a g := by
  simp [lenDerIntro, lenDerIntroB, models_iff, Matrix.vecForall_iff, dlen_defined.iff, (LenDerivable.defined (V := V) TAct).iff]
theorem pa_proves_lenDerIntro : 𝗣𝗔 ⊢ lenDerIntro :=
  Lib.pa_proves_of_models fun _ _ _ ↦ models_lenDerIntro.mpr fun _ _ _ _ h₁ h₂ h₃ ↦ by exact ⟨_, h₁, by rw [← h₂]; exact h₃⟩
theorem lib_lenDerIntro : Lib lenDerIntro := Lib.of_pa pa_proves_lenDerIntro

/-- `a = gBudget k → g = instB n k → LenDerivable a g → boxCore n k` — the target's ONE closing row (§7.1 step 9, as a row). -/
noncomputable def boxIntroB : ArithmeticSemisentence 4 :=
  “n k g a. !gGraph a k → !instBGraph g n k → !(lenDerivableDef TAct) a g → !boxCoreS n k”
noncomputable def boxIntro : ArithmeticSentence := ∀¹* boxIntroB
lemma models_boxIntro : V↓[ℒₒᵣ] ⊧ boxIntro ↔ ∀ n k g a : V, a = gBudget k → g = instB n k → LenDerivable TAct a g → LenDerivable TAct (gBudget k) (instB n k) := by
  simp [boxIntro, boxIntroB, models_iff, Matrix.vecForall_iff, gBudget.defined.iff, instB.defined.iff, (LenDerivable.defined (V := V) TAct).iff, boxRel.defined.iff, boxRel]
theorem pa_proves_boxIntro : 𝗣𝗔 ⊢ boxIntro :=
  Lib.pa_proves_of_models fun _ _ _ ↦ models_boxIntro.mpr fun _ _ _ _ h1 h2 h3 ↦ by subst_vars; first | rfl | assumption | trivial
theorem lib_boxIntro : Lib boxIntro := Lib.of_pa pa_proves_boxIntro

