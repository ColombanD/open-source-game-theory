/-- The fragment-2 table's rows: Frag1's, then the extra rows. -/
noncomputable def frag2Rows : List WRow := frag1Rows ++ frag2ExtraRows

lemma frag2Rows_length : frag2Rows.length = frag2RowCount := rfl

/-- **The fragment-2 proof table**: `frag2RowCount` rows at least, the `i`-th with the arity and the
matrix of `frag2Rows[i]`. -/
def Frag2Table (tbl : V) : Prop :=
  (frag2RowCount : V) ≤ len tbl ∧
  ∀ (i : ℕ) (h : i < frag2Rows.length),
    rowM tbl.[(i : V)] = ((frag2Rows[i]).m : V) ∧ rowB tbl.[(i : V)] = ⌜Semiformula.lMap emb (frag2Rows[i]).B⌝

/-- A fragment-2 table is a fragment-1 table (the first 126 rows). -/
lemma Frag2Table.frag1Table {tbl : V} (h : Frag2Table tbl) : Frag1Table tbl := by
  refine ⟨le_trans (by exact_mod_cast (by decide : frag1RowCount ≤ frag2RowCount)) h.1, ?_⟩
  intro i hi
  have hi' : i < frag2Rows.length := by
    rw [frag2Rows_length]; exact lt_of_lt_of_le (frag1Rows_length ▸ hi) (by decide)
  have := h.2 i hi'
  rwa [show frag2Rows[i] = frag1Rows[i] from List.getElem_append_left hi] at this

lemma Frag2Table.layoutTable {tbl : V} (h : Frag2Table tbl) : LayoutTable tbl := h.frag1Table.layoutTable
lemma Frag2Table.walkTable {tbl : V} (h : Frag2Table tbl) : WalkTable tbl := h.frag1Table.walkTable

/-- **The fragment-2 proof table exists in every model, with one standard length bound.** -/
theorem exists_frag2Table : ∃ N : ℕ, ∀ (V : Type) [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁],
    ∃ tbl : V, TableOK tbl (N : V) ∧ Frag2Table tbl := by
  obtain ⟨N, hN⟩ := exists_rows frag2Rows
  refine ⟨N, fun V _ _ ↦ ?_⟩
  obtain ⟨rows, hlen, hok, hidx⟩ := hN V
  refine ⟨vecOf rows, tableOK_vecOf rows hok, ?_, ?_⟩
  · rw [len_vecOf, hlen, frag2Rows_length]
  · intro i h
    have h' : i < rows.length := by rw [hlen]; exact h
    rw [nth_vecOf rows i h']
    exact hidx i h h'

lemma frag2Table_len {tbl : V} (h : Frag2Table tbl) (i : ℕ) (hi : i < frag2RowCount) : ((i : ℕ) : V) < len tbl :=
  lt_of_lt_of_le (by exact_mod_cast hi) h.1

