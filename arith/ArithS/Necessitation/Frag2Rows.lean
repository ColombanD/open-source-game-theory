/-- Row `totAllIntro` as a step. -/
lemma gok_totAllIntro {tbl N E Γ W : V} {ws wp wd : V} (htbl : TableOK tbl N) (hF : Frag2Table tbl) (hWp : W = frag2Pieces)
    (hΓ : IsFormulaSet LAct Γ) (hws : IsSemiterm LAct 0 ws) (hEws : termLen LAct ws ≤ E) (hwp : IsSemiterm LAct 0 wp) (hEwp : termLen LAct wp ≤ E) (hwd : IsSemiterm LAct 0 wd) (hEwd : termLen LAct wd ≤ E)  :
    StepOK tbl E ((8 : ℕ) : V) Γ (mkStep W 126 ?[ws, wp, wd]) ∧ sTag (mkStep W 126 ?[ws, wp, wd]) = 2 ∧
    ctxAfter Γ (mkStep W 126 ?[ws, wp, wd]) = insert (neg LAct (allIntroFact (^&((0 : ℕ) : V)) (termShift LAct ws) (termShift LAct wp) (termShift LAct wd))) (setShift LAct Γ) := by
  subst hWp
  have hk : ((gIdx_totAllIntro : ℕ) : V) = (126 : V) := by simp [gIdx_totAllIntro]
  have hstep := gmk_totAllIntro (V := V) ?[ws, wp, wd]
  have hlen := frag2Table_len hF gIdx_totAllIntro (by decide)
  have hrow := frag2Table_totAllIntro hF
  rw [hk] at hstep hlen hrow
  have hes : ∀ e ∈ [ws, wp, wd], IsSemiterm LAct 0 e ∧ termLen LAct e ≤ E := List.forall_mem_cons.mpr ⟨⟨hws, hEws⟩, List.forall_mem_cons.mpr ⟨⟨hwp, hEwp⟩, List.forall_mem_cons.mpr ⟨⟨hwd, hEwd⟩, List.forall_mem_nil _⟩⟩⟩
  have hinst := inst_totAllIntro hws hwp hwd
  rw [hstep, show (?[ws, wp, wd] : V) = vecOf [ws, wp, wd] from rfl]
  refine ⟨stepOK_introFact htbl [ws, wp, wd] row_totAllIntro_as hΓ hlen hrow.1 hrow.2 (by exact_mod_cast (by decide : 3 ≤ 8))
    (by rw [show row_totAllIntro_as.length = 0 from rfl] <;> exact_mod_cast (by decide : 0 ≤ 8)) hes ?_, by simp, ?_⟩
  · exact neg_mem_of_map hinst.1 (List.forall_mem_nil _)
  · rw [ctxAfter_introFact [ws, wp, wd] row_totAllIntro_as (by rw [← Nat.cast_succ]; exact isSemiformula_totAllIntro_R) (fun e he ↦ (hes e he).1),
      show row_totAllIntro_R = row_totAllIntro_body from rfl, ← freeIter_one, hinst.2]

