/-- **The piece table of the Frag2 producers**: Frag1's pieces, then the extra rows' pieces. -/
noncomputable def frag2Pieces : V := vecOf (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList ++ frag2ExtraPieceList)

lemma frag2Pieces_nth_lt (i : ℕ) (hi : i < frag1RowCount) : (frag2Pieces : V).[(i : V)] = (frag1Pieces : V).[(i : V)] := by
  unfold frag2Pieces frag1Pieces
  have h1 : i < (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList ++ frag2ExtraPieceList : List V).length := by
    rw [show (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList ++ frag2ExtraPieceList : List V).length = frag2RowCount from rfl]
    exact lt_of_lt_of_le hi (by decide)
  have h2 : i < (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList : List V).length := by
    rw [show (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList : List V).length = frag1RowCount from rfl]; exact hi
  rw [nth_vecOf _ i h1, nth_vecOf _ i h2]
  exact List.getElem_append_left h2

/-- A Frag1 step read from the Frag2 pieces is Frag1's step. -/
lemma mkStep_frag2Pieces_lt (i : ℕ) (hi : i < frag1RowCount) (ev : V) :
    mkStep frag2Pieces (i : V) ev = mkStep frag1Pieces (i : V) ev := by
  rw [mkStep, mkStep, frag2Pieces_nth_lt i hi]

