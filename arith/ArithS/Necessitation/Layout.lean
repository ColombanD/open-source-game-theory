    𝚺₁-Function₄ (fun a b c d : V ↦ subst LAct (listToVec [a, b, c, d]) (⌜τ⌝ : V)) via fact4Def τ := .mk
  fun v ↦ by simp [fact4Def, subst.defined.iff]

