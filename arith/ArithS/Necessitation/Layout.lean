  · simp [h6]
  by_cases h7 : π₁ (v 1) = 7
  · simp [h7]
  by_cases h8 : π₁ (v 1) = 8
  · simp [h8]
  by_cases h9 : π₁ (v 1) = 9
  · simp [h9]
