/-- The layout table's rows: the walk's followed by the extra rows. -/
noncomputable def layoutRows : List WRow := walkRows ++ layoutExtraRows

lemma layoutRows_length : layoutRows.length = layoutRowCount := rfl

/-- **The layout proof table**: `layoutRowCount` rows at least, the `i`-th with the arity and the matrix
of `layoutRows[i]`. -/
def LayoutTable (tbl : V) : Prop :=
  (layoutRowCount : V) ≤ len tbl ∧
  ∀ (i : ℕ) (h : i < layoutRows.length),
    rowM tbl.[(i : V)] = ((layoutRows[i]).m : V) ∧ rowB tbl.[(i : V)] = ⌜Semiformula.lMap emb (layoutRows[i]).B⌝

/-- A layout table is a walk table (the first 40 rows). -/
lemma LayoutTable.walkTable {tbl : V} (h : LayoutTable tbl) : WalkTable tbl := by
  refine ⟨le_trans (by exact_mod_cast (by decide : walkRowCount ≤ layoutRowCount)) h.1, ?_⟩
  intro i hi
  have hi' : i < layoutRows.length := by
    rw [layoutRows_length]; exact lt_of_lt_of_le (walkRows_length ▸ hi) (by decide)
  have := h.2 i hi'
  rwa [show layoutRows[i] = walkRows[i] from List.getElem_append_left hi] at this

/-- **The layout proof table exists in every model, with one standard length bound.** -/
theorem exists_layoutTable : ∃ N : ℕ, ∀ (V : Type) [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁],
    ∃ tbl : V, TableOK tbl (N : V) ∧ LayoutTable tbl := by
  obtain ⟨N, hN⟩ := exists_rows layoutRows
  refine ⟨N, fun V _ _ ↦ ?_⟩
  obtain ⟨rows, hlen, hok, hidx⟩ := hN V
  refine ⟨vecOf rows, tableOK_vecOf rows hok, ?_, ?_⟩
  · rw [len_vecOf, hlen, layoutRows_length]
  · intro i h
    have h' : i < rows.length := by rw [hlen]; exact h
    rw [nth_vecOf rows i h']
    exact hidx i h h'

lemma layoutTable_len {tbl : V} (h : LayoutTable tbl) (i : ℕ) (hi : i < layoutRowCount) : ((i : ℕ) : V) < len tbl :=
  lt_of_lt_of_le (by exact_mod_cast hi) h.1

