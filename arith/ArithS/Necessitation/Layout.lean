/-- **The piece table of the layout producers** (a closed V-generic term extending `walkPieces`). -/
noncomputable def layoutPieces : V := vecOf (walkPieceList ++ layoutExtraPieceList)

lemma layoutPieces_nth_lt (i : ℕ) (hi : i < walkRowCount) : (layoutPieces : V).[(i : V)] = (walkPieces : V).[(i : V)] := by
  unfold layoutPieces walkPieces
  have h1 : i < (walkPieceList ++ layoutExtraPieceList : List V).length := by
    rw [show (walkPieceList ++ layoutExtraPieceList : List V).length = layoutRowCount from rfl]
    exact lt_of_lt_of_le hi (by decide)
  have h2 : i < (walkPieceList : List V).length := by
    rw [show (walkPieceList : List V).length = walkRowCount from rfl]; exact hi
  rw [nth_vecOf _ i h1, nth_vecOf _ i h2]
  exact List.getElem_append_left h2

/-- A walk step read from the layout pieces is the walk's step. -/
lemma mkStep_layoutPieces_lt (i : ℕ) (hi : i < walkRowCount) (ev : V) :
    mkStep layoutPieces (i : V) ev = mkStep walkPieces (i : V) ev := by
  rw [mkStep, mkStep, layoutPieces_nth_lt i hi]

lemma layoutPieces_eqTotal : (layoutPieces : V).[((lIdx_eqTotal : ℕ) : V)] = lpiece_eqTotal := by
  unfold layoutPieces
  rw [nth_vecOf _ lIdx_eqTotal (Nat.lt_of_sub_eq_succ rfl)]
  rfl

lemma lmk_eqTotal (ev : V) :
    mkStep layoutPieces ((lIdx_eqTotal : ℕ) : V) ev = sIntroFact ((lIdx_eqTotal : ℕ) : V) ev (vecOf row_eqTotal_as) row_eqTotal_R := by
  rw [mkStep, layoutPieces_eqTotal]
  simp [lpiece_eqTotal, sIntroFact]

lemma ltag_eqTotal {W : V} (hWp : W = layoutPieces) (ev : V) : sTag (mkStep W (40 : V) ev) = 2 := by
  subst hWp
  have hk : ((lIdx_eqTotal : ℕ) : V) = (40 : V) := by simp [lIdx_eqTotal]
  rw [← hk, lmk_eqTotal]; simp

