/-- Sixty copies of the walk's first row fill indices `40 … 99` (room for the layout rows). -/
noncomputable def padRows : List WRow := List.replicate 60 ⟨1, zeroLtSuccB, lib_zeroLtSucc⟩

/-- The certification table's rows: the walk's, the pad, the extra rows. -/
noncomputable def certTailRows : List WRow := padRows ++ certExtraRows
noncomputable def certRows : List WRow := walkRows ++ certTailRows

lemma certRows_length : certRows.length = certRowCount := rfl

/-- **The certification proof table**: `certRowCount` rows at least, the `i`-th with the arity and the matrix
of `certRows[i]`. -/
def CertTable (tbl : V) : Prop :=
  (certRowCount : V) ≤ len tbl ∧
  ∀ (i : ℕ) (h : i < certRows.length),
    rowM tbl.[(i : V)] = ((certRows[i]).m : V) ∧ rowB tbl.[(i : V)] = ⌜Semiformula.lMap emb (certRows[i]).B⌝

/-- A certification table is a walk table (the first 40 rows). -/
lemma CertTable.walkTable {tbl : V} (h : CertTable tbl) : WalkTable tbl := by
  refine ⟨le_trans (by exact_mod_cast (by decide : walkRowCount ≤ certRowCount)) h.1, ?_⟩
  intro i hi
  have hi' : i < certRows.length := by
    rw [certRows_length]; exact lt_of_lt_of_le (walkRows_length ▸ hi) (by decide)
  have := h.2 i hi'
  rwa [show certRows[i] = walkRows[i] from List.getElem_append_left hi] at this

/-- **The certification proof table exists in every model, with one standard length bound.** -/
theorem exists_certTable : ∃ N : ℕ, ∀ (V : Type) [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁],
    ∃ tbl : V, TableOK tbl (N : V) ∧ CertTable tbl := by
  obtain ⟨N, hN⟩ := exists_rows certRows
  refine ⟨N, fun V _ _ ↦ ?_⟩
  obtain ⟨rows, hlen, hok, hidx⟩ := hN V
  refine ⟨vecOf rows, tableOK_vecOf rows hok, ?_, ?_⟩
  · rw [len_vecOf, hlen, certRows_length]
  · intro i h
    have h' : i < rows.length := by rw [hlen]; exact h
    rw [nth_vecOf rows i h']
    exact hidx i h h'

lemma certTable_len {tbl : V} (h : CertTable tbl) (i : ℕ) (hi : i < certRowCount) : ((i : ℕ) : V) < len tbl :=
  lt_of_lt_of_le (by exact_mod_cast hi) h.1

/-! ### The per-row readings of `CertTable` -/

lemma certTable_negRelCert {tbl : V} (h : CertTable tbl) :
    rowM tbl.[((cIdx_negRelCert : ℕ) : V)] = ((5 : ℕ) : V) ∧
    rowB tbl.[((cIdx_negRelCert : ℕ) : V)] = impChainV LAct (vecOf row_negRelCert_as) row_negRelCert_c := by
  have this : rowM tbl.[((cIdx_negRelCert : ℕ) : V)] = ((5 : ℕ) : V) ∧
      rowB tbl.[((cIdx_negRelCert : ℕ) : V)] = ⌜Semiformula.lMap emb negRelCertB⌝ :=
    h.2 cIdx_negRelCert (Nat.lt_of_sub_eq_succ rfl)
  refine ⟨this.1, ?_⟩
  rw [impChainV_vecOf, this.2, quote_row_negRelCert]

