/-! ### The per-row applicability lemmas `cok_<row>` -/

/-- Row `negRelCert` as a step. -/
lemma cok_negRelCert {tbl N E Γ W : V} {wr wk wR wv wy : V} (htbl : TableOK tbl N) (hC : CertTable tbl) (hWp : W = certPieces)
    (hΓ : IsFormulaSet LAct Γ) (hwr : IsSemiterm LAct 0 wr) (hEwr : termLen LAct wr ≤ E) (hwk : IsSemiterm LAct 0 wk) (hEwk : termLen LAct wk ≤ E) (hwR : IsSemiterm LAct 0 wR) (hEwR : termLen LAct wR ≤ E) (hwv : IsSemiterm LAct 0 wv) (hEwv : termLen LAct wv ≤ E) (hwy : IsSemiterm LAct 0 wy) (hEwy : termLen LAct wy ≤ E) (hmem0 : neg LAct (isRelFact wk wR) ∈ Γ) (hmem1 : neg LAct (utvPiFact wk wv) ∈ Γ) (hmem2 : neg LAct (relFact wr wk wR wv) ∈ Γ) (hmem3 : neg LAct (nrelFact wy wk wR wv) ∈ Γ) :
    StepOK tbl E ((8 : ℕ) : V) Γ (mkStep W 100 ?[wr, wk, wR, wv, wy]) ∧ sTag (mkStep W 100 ?[wr, wk, wR, wv, wy]) = 0 ∧
    ctxAfter Γ (mkStep W 100 ?[wr, wk, wR, wv, wy]) = insert (neg LAct (negFact wy wr)) Γ := by
  subst hWp
  have hk : ((cIdx_negRelCert : ℕ) : V) = (100 : V) := by simp [cIdx_negRelCert]
  have hstep := cmk_negRelCert (V := V) ?[wr, wk, wR, wv, wy]
  have hlen := certTable_len hC cIdx_negRelCert (by decide)
  have hrow := certTable_negRelCert hC
  rw [hk] at hstep hlen hrow
  have hes : ∀ e ∈ [wr, wk, wR, wv, wy], IsSemiterm LAct 0 e ∧ termLen LAct e ≤ E := List.forall_mem_cons.mpr ⟨⟨hwr, hEwr⟩, List.forall_mem_cons.mpr ⟨⟨hwk, hEwk⟩, List.forall_mem_cons.mpr ⟨⟨hwR, hEwR⟩, List.forall_mem_cons.mpr ⟨⟨hwv, hEwv⟩, List.forall_mem_cons.mpr ⟨⟨hwy, hEwy⟩, List.forall_mem_nil _⟩⟩⟩⟩⟩
  have hinst := inst_negRelCert hwr hwk hwR hwv hwy
  rw [hstep, show (?[wr, wk, wR, wv, wy] : V) = vecOf [wr, wk, wR, wv, wy] from rfl]
  refine ⟨stepOK_useHorn htbl [wr, wk, wR, wv, wy] row_negRelCert_as hΓ hlen hrow.1 hrow.2 (by exact_mod_cast (by decide : 5 ≤ 8))
    (by rw [show row_negRelCert_as.length = 4 from rfl]; exact_mod_cast (by decide : 4 ≤ 8)) hes ?_, by simp, ?_⟩
  · exact neg_mem_of_map hinst.1 (List.forall_mem_cons.mpr ⟨hmem0, List.forall_mem_cons.mpr ⟨hmem1, List.forall_mem_cons.mpr ⟨hmem2, List.forall_mem_cons.mpr ⟨hmem3, List.forall_mem_nil _⟩⟩⟩⟩)
  · rw [ctxAfter_useHorn [wr, wk, wR, wv, wy] row_negRelCert_as isSemiformula_negRelCert_c (fun e he ↦ (hes e he).1), hinst.2]

/-- Row `negNRelCert` as a step. -/
