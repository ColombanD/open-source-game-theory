    StepOK tbl E ((8 : ℕ) : V) Γ (mkStep W 101 ?[wr, wk, wR, wv, wy]) ∧ sTag (mkStep W 101 ?[wr, wk, wR, wv, wy]) = 0 ∧
    ctxAfter Γ (mkStep W 101 ?[wr, wk, wR, wv, wy]) = insert (neg LAct (negFact wy wr)) Γ := by
  subst hWp
  have hk : ((cIdx_negNRelCert : ℕ) : V) = (101 : V) := by simp [cIdx_negNRelCert]
  have hstep := cmk_negNRelCert (V := V) ?[wr, wk, wR, wv, wy]
