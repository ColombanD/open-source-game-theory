theorem quote_row_formulaLenVerum : (⌜Semiformula.lMap emb formulaLenVerumB⌝ : V) = impChain LAct row_formulaLenVerum_as row_formulaLenVerum_c := by
  unfold formulaLenVerumB row_formulaLenVerum_as row_formulaLenVerum_c PeqB PflenG Pverum
  all_goals row_shapeB

