noncomputable def padPieceList : List V := List.replicate 60 piece_zeroLtSucc

/-- **The piece table of the certification producers**: the walk's pieces, the pad, the extra rows' pieces. -/
noncomputable def certTailPieceList : List V := padPieceList ++ certExtraPieceList
noncomputable def certPieces : V := vecOf (walkPieceList ++ certTailPieceList)

lemma certPieces_nth_lt (i : ℕ) (hi : i < walkRowCount) : (certPieces : V).[(i : V)] = (walkPieces : V).[(i : V)] := by
  unfold certPieces walkPieces
  have h1 : i < (walkPieceList ++ certTailPieceList : List V).length := by
    rw [show (walkPieceList ++ certTailPieceList : List V).length = certRowCount from rfl]
    exact lt_of_lt_of_le hi (by decide)
  have h2 : i < (walkPieceList : List V).length := by
    rw [show (walkPieceList : List V).length = walkRowCount from rfl]; exact hi
  rw [nth_vecOf _ i h1, nth_vecOf _ i h2]
  exact List.getElem_append_left h2

/-- A walk step read from the certification pieces is the walk's step. -/
lemma mkStep_certPieces_lt (i : ℕ) (hi : i < walkRowCount) (ev : V) :
    mkStep certPieces (i : V) ev = mkStep walkPieces (i : V) ev := by
  rw [mkStep, mkStep, certPieces_nth_lt i hi]

lemma certPieces_negRelCert : (certPieces : V).[((cIdx_negRelCert : ℕ) : V)] = cpiece_negRelCert := by
  unfold certPieces
  rw [nth_vecOf _ cIdx_negRelCert (Nat.lt_of_sub_eq_succ rfl)]
  rfl

lemma cmk_negRelCert (ev : V) :
    mkStep certPieces ((cIdx_negRelCert : ℕ) : V) ev = sUseHorn ((cIdx_negRelCert : ℕ) : V) ev (vecOf row_negRelCert_as) row_negRelCert_c := by
  rw [mkStep, certPieces_negRelCert]
  simp [cpiece_negRelCert, sUseHorn]

lemma ctag_negRelCert {W : V} (hWp : W = certPieces) (ev : V) : sTag (mkStep W (100 : V) ev) = 0 := by
  subst hWp
  have hk : ((cIdx_negRelCert : ℕ) : V) = (100 : V) := by simp [cIdx_negRelCert]
  rw [← hk, cmk_negRelCert]; simp

