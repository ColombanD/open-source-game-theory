/-- **The piece table of the fragment producers**: the layout's pieces, then the extra rows' pieces. -/
noncomputable def frag1Pieces : V := vecOf (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList)

lemma frag1Pieces_nth_lt (i : ℕ) (hi : i < layoutRowCount) : (frag1Pieces : V).[(i : V)] = (layoutPieces : V).[(i : V)] := by
  unfold frag1Pieces layoutPieces
  have h1 : i < (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList : List V).length := by
    rw [show (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList : List V).length = frag1RowCount from rfl]
    exact lt_of_lt_of_le hi (by decide)
  have h2 : i < (walkPieceList ++ layoutExtraPieceList : List V).length := by
    rw [show (walkPieceList ++ layoutExtraPieceList : List V).length = layoutRowCount from rfl]; exact hi
  rw [nth_vecOf _ i h1, nth_vecOf _ i h2]
  exact List.getElem_append_left h2

/-- A layout step read from the fragment pieces is the layout's step. -/
lemma mkStep_frag1Pieces_lt (i : ℕ) (hi : i < layoutRowCount) (ev : V) :
    mkStep frag1Pieces (i : V) ev = mkStep layoutPieces (i : V) ev := by
  rw [mkStep, mkStep, frag1Pieces_nth_lt i hi]

