  unfold frag1Pieces
  rw [nth_vecOf _ fIdx_totAxL (Nat.lt_of_sub_eq_succ rfl)]
  rfl

lemma fmk_totAxL (ev : V) :
    mkStep frag1Pieces ((fIdx_totAxL : ℕ) : V) ev = sIntroFact ((fIdx_totAxL : ℕ) : V) ev (vecOf row_totAxL_as) row_totAxL_R := by
  rw [mkStep, frag1Pieces_totAxL]
  simp [fpiece_totAxL, sIntroFact]

lemma ftag_totAxL {W : V} (hWp : W = frag1Pieces) (ev : V) : sTag (mkStep W (87 : V) ev) = 2 := by
  subst hWp
  have hk : ((fIdx_totAxL : ℕ) : V) = (87 : V) := by simp [fIdx_totAxL]
