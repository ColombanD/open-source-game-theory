/-! ### The per-row applicability lemmas `fok_<row>` (at `M = 8`, or `M = 9` for the nine-witness rows) -/

/-- Row `totAxL` as a step. -/
lemma fok_totAxL {tbl N E Γ W : V} {ws wp : V} (htbl : TableOK tbl N) (hF : Frag1Table tbl) (hWp : W = frag1Pieces)
    (hΓ : IsFormulaSet LAct Γ) (hws : IsSemiterm LAct 0 ws) (hEws : termLen LAct ws ≤ E) (hwp : IsSemiterm LAct 0 wp) (hEwp : termLen LAct wp ≤ E)  :
    StepOK tbl E ((8 : ℕ) : V) Γ (mkStep W 87 ?[ws, wp]) ∧ sTag (mkStep W 87 ?[ws, wp]) = 2 ∧
    ctxAfter Γ (mkStep W 87 ?[ws, wp]) = insert (neg LAct (axLFact (^&((0 : ℕ) : V)) (termShift LAct ws) (termShift LAct wp))) (setShift LAct Γ) := by
  subst hWp
  have hk : ((fIdx_totAxL : ℕ) : V) = (87 : V) := by simp [fIdx_totAxL]
  have hstep := fmk_totAxL (V := V) ?[ws, wp]
  have hlen := frag1Table_len hF fIdx_totAxL (by decide)
  have hrow := frag1Table_totAxL hF
  rw [hk] at hstep hlen hrow
  have hes : ∀ e ∈ [ws, wp], IsSemiterm LAct 0 e ∧ termLen LAct e ≤ E := List.forall_mem_cons.mpr ⟨⟨hws, hEws⟩, List.forall_mem_cons.mpr ⟨⟨hwp, hEwp⟩, List.forall_mem_nil _⟩⟩
  have hinst := inst_totAxL hws hwp
  rw [hstep, show (?[ws, wp] : V) = vecOf [ws, wp] from rfl]
  refine ⟨stepOK_introFact htbl [ws, wp] row_totAxL_as hΓ hlen hrow.1 hrow.2 (by exact_mod_cast (by decide : 2 ≤ 8))
    (by rw [show row_totAxL_as.length = 0 from rfl] <;> exact_mod_cast (by decide : 0 ≤ 8)) hes ?_, by simp, ?_⟩
  · exact neg_mem_of_map hinst.1 (List.forall_mem_nil _)
  · rw [ctxAfter_introFact [ws, wp] row_totAxL_as (by rw [← Nat.cast_succ]; exact isSemiformula_totAxL_R) (fun e he ↦ (hes e he).1),
      show row_totAxL_R = row_totAxL_body from rfl, ← freeIter_one, hinst.2]

/-- Row `totVerumIntro` as a step. -/
lemma fok_totVerumIntro {tbl N E Γ W : V} {ws : V} (htbl : TableOK tbl N) (hF : Frag1Table tbl) (hWp : W = frag1Pieces)
    (hΓ : IsFormulaSet LAct Γ) (hws : IsSemiterm LAct 0 ws) (hEws : termLen LAct ws ≤ E)  :
    StepOK tbl E ((8 : ℕ) : V) Γ (mkStep W 88 ?[ws]) ∧ sTag (mkStep W 88 ?[ws]) = 2 ∧
    ctxAfter Γ (mkStep W 88 ?[ws]) = insert (neg LAct (verumIntroFact (^&((0 : ℕ) : V)) (termShift LAct ws))) (setShift LAct Γ) := by
  subst hWp
  have hk : ((fIdx_totVerumIntro : ℕ) : V) = (88 : V) := by simp [fIdx_totVerumIntro]
  have hstep := fmk_totVerumIntro (V := V) ?[ws]
  have hlen := frag1Table_len hF fIdx_totVerumIntro (by decide)
  have hrow := frag1Table_totVerumIntro hF
  rw [hk] at hstep hlen hrow
  have hes : ∀ e ∈ [ws], IsSemiterm LAct 0 e ∧ termLen LAct e ≤ E := List.forall_mem_cons.mpr ⟨⟨hws, hEws⟩, List.forall_mem_nil _⟩
  have hinst := inst_totVerumIntro hws
  rw [hstep, show (?[ws] : V) = vecOf [ws] from rfl]
  refine ⟨stepOK_introFact htbl [ws] row_totVerumIntro_as hΓ hlen hrow.1 hrow.2 (by exact_mod_cast (by decide : 1 ≤ 8))
    (by rw [show row_totVerumIntro_as.length = 0 from rfl] <;> exact_mod_cast (by decide : 0 ≤ 8)) hes ?_, by simp, ?_⟩
  · exact neg_mem_of_map hinst.1 (List.forall_mem_nil _)
  · rw [ctxAfter_introFact [ws] row_totVerumIntro_as (by rw [← Nat.cast_succ]; exact isSemiformula_totVerumIntro_R) (fun e he ↦ (hes e he).1),
      show row_totVerumIntro_R = row_totVerumIntro_body from rfl, ← freeIter_one, hinst.2]

/-- Row `totAndIntro` as a step. -/
lemma fok_totAndIntro {tbl N E Γ W : V} {ws wp wq wdp wdq : V} (htbl : TableOK tbl N) (hF : Frag1Table tbl) (hWp : W = frag1Pieces)
