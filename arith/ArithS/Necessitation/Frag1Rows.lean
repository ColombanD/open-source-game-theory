/-- The fragment table's rows: the layout's (walk + copy/identification/chain), then the extra rows. -/
noncomputable def frag1Rows : List WRow := layoutRows ++ frag1ExtraRows

lemma frag1Rows_length : frag1Rows.length = frag1RowCount := rfl

/-- **The fragment proof table**: `frag1RowCount` rows at least, the `i`-th with the arity and the matrix
of `frag1Rows[i]`. -/
def Frag1Table (tbl : V) : Prop :=
  (frag1RowCount : V) ≤ len tbl ∧
  ∀ (i : ℕ) (h : i < frag1Rows.length),
    rowM tbl.[(i : V)] = ((frag1Rows[i]).m : V) ∧ rowB tbl.[(i : V)] = ⌜Semiformula.lMap emb (frag1Rows[i]).B⌝

/-- A fragment table is a layout table (the first 87 rows). -/
lemma Frag1Table.layoutTable {tbl : V} (h : Frag1Table tbl) : LayoutTable tbl := by
  refine ⟨le_trans (by exact_mod_cast (by decide : layoutRowCount ≤ frag1RowCount)) h.1, ?_⟩
  intro i hi
  have hi' : i < frag1Rows.length := by
    rw [frag1Rows_length]; exact lt_of_lt_of_le (layoutRows_length ▸ hi) (by decide)
  have := h.2 i hi'
  rwa [show frag1Rows[i] = layoutRows[i] from List.getElem_append_left hi] at this

lemma Frag1Table.walkTable {tbl : V} (h : Frag1Table tbl) : WalkTable tbl := h.layoutTable.walkTable

/-- **The fragment proof table exists in every model, with one standard length bound.** -/
theorem exists_frag1Table : ∃ N : ℕ, ∀ (V : Type) [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁],
    ∃ tbl : V, TableOK tbl (N : V) ∧ Frag1Table tbl := by
  obtain ⟨N, hN⟩ := exists_rows frag1Rows
  refine ⟨N, fun V _ _ ↦ ?_⟩
  obtain ⟨rows, hlen, hok, hidx⟩ := hN V
  refine ⟨vecOf rows, tableOK_vecOf rows hok, ?_, ?_⟩
  · rw [len_vecOf, hlen, frag1Rows_length]
  · intro i h
    have h' : i < rows.length := by rw [hlen]; exact h
    rw [nth_vecOf rows i h']
    exact hidx i h h'

lemma frag1Table_len {tbl : V} (h : Frag1Table tbl) (i : ℕ) (hi : i < frag1RowCount) : ((i : ℕ) : V) < len tbl :=
  lt_of_lt_of_le (by exact_mod_cast hi) h.1

