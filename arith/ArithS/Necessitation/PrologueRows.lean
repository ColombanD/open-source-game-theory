/-! ### The piece table -/

noncomputable def ppiece_setLenSingLe : V := ⟪(0 : V), vecOf row_setLenSingLe_as, row_setLenSingLe_c⟫
noncomputable def ppiece_setLenEmptyLe : V := ⟪(0 : V), vecOf row_setLenEmptyLe_as, row_setLenEmptyLe_c⟫
