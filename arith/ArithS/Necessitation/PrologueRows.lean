noncomputable def proExtraPieceList : List V := [
  ppiece_setLenSingLe,
  ppiece_setLenEmptyLe,
  ppiece_congSubsetL,
  ppiece_congSetShiftR,
  ppiece_leOfEqP
]

/-- **The piece table of the prologue producers**: the top's pieces, then the extra rows' pieces. -/
noncomputable def proPieces : V := vecOf (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList ++ frag2ExtraPieceList ++ topExtraPieceList ++ proExtraPieceList)

lemma proPieces_nth_lt (i : ℕ) (hi : i < topRowCount) : (proPieces : V).[(i : V)] = (topPieces : V).[(i : V)] := by
  unfold proPieces topPieces
  have h1 : i < (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList ++ frag2ExtraPieceList ++ topExtraPieceList ++ proExtraPieceList : List V).length := by
    rw [show (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList ++ frag2ExtraPieceList ++ topExtraPieceList ++ proExtraPieceList : List V).length = topRowCount + proExtraRowCount from rfl]
    exact lt_of_lt_of_le hi (Nat.le_add_right _ _)
  have h2 : i < (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList ++ frag2ExtraPieceList ++ topExtraPieceList : List V).length := by
    rw [show (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList ++ frag2ExtraPieceList ++ topExtraPieceList : List V).length = topRowCount from rfl]; exact hi
  rw [nth_vecOf _ i h1, nth_vecOf _ i h2]
  exact List.getElem_append_left h2

/-- A top step read from the prologue pieces is the top's step. -/
lemma mkStep_proPieces_lt (i : ℕ) (hi : i < topRowCount) (ev : V) :
    mkStep proPieces (i : V) ev = mkStep topPieces (i : V) ev := by
  rw [mkStep, mkStep, proPieces_nth_lt i hi]

lemma proPieces_setLenSingLe : (proPieces : V).[((pIdx_setLenSingLe : ℕ) : V)] = ppiece_setLenSingLe := by
  unfold proPieces
  rw [nth_vecOf _ pIdx_setLenSingLe (Nat.lt_of_sub_eq_succ rfl)]
  rfl

