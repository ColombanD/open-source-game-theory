    mkStep proPieces ((pIdx_setLenSingLe : ℕ) : V) ev = sUseHorn ((pIdx_setLenSingLe : ℕ) : V) ev (vecOf row_setLenSingLe_as) row_setLenSingLe_c := by
  rw [mkStep, proPieces_setLenSingLe]
  simp [ppiece_setLenSingLe, sUseHorn]

