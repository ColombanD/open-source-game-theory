    rowM tbl.[((iIdx_qqAllsZero : ℕ) : V)] = ((1 : ℕ) : V) ∧
    rowB tbl.[((iIdx_qqAllsZero : ℕ) : V)] = impChainV LAct (vecOf row_qqAllsZero_as) row_qqAllsZero_c := by
  have := h.extra 0 (by decide)
  have e : ((iIdx_qqAllsZero : ℕ) : V) = ((proAxmRowCount + 0 : ℕ) : V) := rfl
