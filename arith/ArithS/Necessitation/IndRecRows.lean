theorem lib_c0Intro : Lib c0Intro := Lib.of_pa pa_proves_c0Intro

/-- the six shape facts of `⟨⌜#0 + 1⌝⟩` give `IsC1 c`. -/
noncomputable def c1IntroB : ArithmeticSemisentence 6 :=
  “c t v2 x v1 o. !qqFuncDef o 0 (0 + 1) 0 → !adjoinDef v1 o 0 → !qqBvarDef x 0 → !adjoinDef v2 x v1 → !qqFuncDef t (0 + 1 + 1) 0 v2 → !adjoinDef c t 0 → !isC1Def c”
noncomputable def c1Intro : ArithmeticSentence := ∀¹* c1IntroB
lemma models_c1Intro : V↓[ℒₒᵣ] ⊧ c1Intro ↔ ∀ c t v2 x v1 o : V, o = ^func (0 : V) ((0 : V) + 1) (0 : V) → v1 = o ∷ (0 : V) → x = ^#(0 : V) → v2 = x ∷ v1 → t = ^func ((0 : V) + 1 + 1) (0 : V) v2 → c = t ∷ (0 : V) → IsC1 c := by
  simp [c1Intro, c1IntroB, models_iff, Matrix.vecForall_iff, isC1_defined.iff]
theorem pa_proves_c1Intro : 𝗣𝗔 ⊢ c1Intro :=
  Lib.pa_proves_of_models fun _ _ _ ↦ models_c1Intro.mpr fun _ _ _ _ _ _ h₁ h₂ h₃ h₄ h₅ h₆ ↦ ⟨_, _, _, _, _, h₁, h₂, h₃, h₄, h₅, h₆⟩
theorem lib_c1Intro : Lib c1Intro := Lib.of_pa pa_proves_c1Intro

/-- the five shape facts of `s = x ⋎ ((∃ (K ⋏ ns)) ⋎ (∀ K2))` and `K2 = K` give `BodyShape s x ns K`. -/
noncomputable def bodyIntroB : ArithmeticSemisentence 9 :=
  “s x y u z n1 K ns K2. !qqOrDef s x y → !qqOrDef y u z → !qqExsDef u n1 → !qqAndDef n1 K ns → !qqAllDef z K2 → K2 = K → !bodyShapeDef s x ns K”
noncomputable def bodyIntro : ArithmeticSentence := ∀¹* bodyIntroB
lemma models_bodyIntro : V↓[ℒₒᵣ] ⊧ bodyIntro ↔ ∀ s x y u z n1 K ns K2 : V, s = x ^⋎ y → y = u ^⋎ z → u = ^∃ n1 → n1 = K ^⋏ ns → z = ^∀ K2 → K2 = K → BodyShape s x ns K := by
  simp [bodyIntro, bodyIntroB, models_iff, Matrix.vecForall_iff, bodyShape_defined.iff]
theorem pa_proves_bodyIntro : 𝗣𝗔 ⊢ bodyIntro :=
  Lib.pa_proves_of_models fun _ _ _ ↦ models_bodyIntro.mpr fun _ _ _ _ _ _ _ _ _ h₁ h₂ h₃ h₄ h₅ h₆ ↦ ⟨_, _, _, _, h₁, h₂, h₃, h₄, h₆ ▸ h₅⟩
theorem lib_bodyIntro : Lib bodyIntro := Lib.of_pa pa_proves_bodyIntro

/-- `BodyShape s x ns K → nk = neg K → IsC0 c0 → x = subst c0 nk → IsC1 c1 → ns = subst c1 nk → IndBodyL s K`. -/
noncomputable def indBodyIntroLB : ArithmeticSemisentence 7 :=
  “s K x ns nk c0 c1. !bodyShapeDef s x ns K → !(negGraph LAct) nk K → !isC0Def c0 → !(substsGraph LAct) x c0 nk → !isC1Def c1 → !(substsGraph LAct) ns c1 nk → !indBodyLDef s K”
noncomputable def indBodyIntroL : ArithmeticSentence := ∀¹* indBodyIntroLB
lemma models_indBodyIntroL : V↓[ℒₒᵣ] ⊧ indBodyIntroL ↔ ∀ s K x ns nk c0 c1 : V, BodyShape s x ns K → nk = neg LAct K → IsC0 c0 → x = subst LAct c0 nk → IsC1 c1 → ns = subst LAct c1 nk → IndBodyL s K := by
  simp [indBodyIntroL, indBodyIntroLB, models_iff, Matrix.vecForall_iff, bodyShape_defined.iff, isC0_defined.iff, subst.defined.iff, isC1_defined.iff, indBodyL_defined.iff]
theorem pa_proves_indBodyIntroL : 𝗣𝗔 ⊢ indBodyIntroL :=
  Lib.pa_proves_of_models fun _ _ _ ↦ models_indBodyIntroL.mpr fun _ _ _ _ _ _ _ h₁ h₂ h₃ h₄ h₅ h₆ ↦ ⟨_, _, _, _, _, h₁, h₂, h₃, h₄, h₅, h₆⟩
theorem lib_indBodyIntroL : Lib indBodyIntroL := Lib.of_pa pa_proves_indBodyIntroL

/-- **THE RECOGNIZER**: `p = qqAlls b m → BsF m m b → b = shift b → FvSeq fv 0 m → s = subst fv b → IndBodyL s K → p ∈ TAct.Δ₁Class` — every hypothesis in the `LAct` vocabulary of the walked facts (`inductionR_of_L`). -/
noncomputable def indRecLB : ArithmeticSemisentence 6 :=
  “K s fv b m p. !qqAllsDef p b m → !bsFDef m m b → !(shiftGraph LAct) b b → !fvSeqDef fv 0 m → !(substsGraph LAct) s fv b → !indBodyLDef s K → !(Theory.Δ₁ch TAct).sigma p”
noncomputable def indRecL : ArithmeticSentence := ∀¹* indRecLB
lemma models_indRecL : V↓[ℒₒᵣ] ⊧ indRecL ↔ ∀ K s fv b m p : V, p = qqAlls b m → BsF m m b → b = shift LAct b → FvSeq fv (0 : V) m → s = subst LAct fv b → IndBodyL s K → p ∈ TAct.Δ₁Class := by
  simp [indRecL, indRecLB, models_iff, Matrix.vecForall_iff, qqAlls_defined.iff, bsF_defined.iff, shift.defined.iff, fvSeq_defined.iff, subst.defined.iff, indBodyL_defined.iff]
theorem pa_proves_indRecL : 𝗣𝗔 ⊢ indRecL :=
  Lib.pa_proves_of_models fun _ _ _ ↦ models_indRecL.mpr fun _ _ _ _ _ _ h₁ h₂ h₃ h₄ h₅ h₆ ↦ inductionR_of_L h₁ h₂ h₃ h₄ h₅ h₆
theorem lib_indRecL : Lib indRecL := Lib.of_pa pa_proves_indRecL

end indRecLib

