/-! ### The table predicate and its per-row readings -/

/-- The recognizer table: `indRecRowCount` rows at least, the `i`-th with the arity and matrix of `indRecRows[i]`. -/
def IndRecTable (tbl : V) : Prop :=
  (indRecRowCount : V) ≤ len tbl ∧
  ∀ (i : ℕ) (h : i < indRecRows.length),
    rowM tbl.[(i : V)] = ((indRecRows[i]).m : V) ∧ rowB tbl.[(i : V)] = ⌜Semiformula.lMap emb (indRecRows[i]).B⌝

lemma IndRecTable.proAxmTable {tbl : V} (h : IndRecTable tbl) : ProAxmTable tbl := by
  refine ⟨le_trans (by exact_mod_cast (show proAxmRowCount ≤ indRecRowCount by simp only [indRecRowCount]; omega)) h.1, ?_⟩
  intro i hi
  have hi' : i < indRecRows.length := by
    rw [indRecRows_length]; rw [proAxmRows_length] at hi; simp only [indRecRowCount]; omega
  have := h.2 i hi'
  rwa [show indRecRows[i] = proAxmRows[i] from List.getElem_append_left hi] at this

lemma IndRecTable.numIdTable {tbl : V} (h : IndRecTable tbl) : NumIdTable tbl := h.proAxmTable.numIdTable
lemma IndRecTable.proTable {tbl : V} (h : IndRecTable tbl) : ProTable tbl := h.proAxmTable.proTable
lemma IndRecTable.layoutTable {tbl : V} (h : IndRecTable tbl) : LayoutTable tbl := h.proAxmTable.layoutTable
lemma IndRecTable.walkTable {tbl : V} (h : IndRecTable tbl) : WalkTable tbl := h.proAxmTable.walkTable

/-- The reading of the `k`-th extra row. -/
lemma IndRecTable.extra {tbl : V} (h : IndRecTable tbl) (k : ℕ) (hk : k < indRecExtraRowCount) :
    ((proAxmRowCount + k : ℕ) : V) < len tbl ∧
    rowM tbl.[((proAxmRowCount + k : ℕ) : V)] = ((indRecExtraRows[k]'(by rw [indRecExtraRows_length]; exact hk)).m : V) ∧
    rowB tbl.[((proAxmRowCount + k : ℕ) : V)] =
      ⌜Semiformula.lMap emb (indRecExtraRows[k]'(by rw [indRecExtraRows_length]; exact hk)).B⌝ := by
  have hlt : proAxmRowCount + k < indRecRows.length := by rw [indRecRows_length]; simp only [indRecRowCount]; omega
  have hr := h.2 (proAxmRowCount + k) hlt
  have hk' : k < indRecExtraRows.length := by rw [indRecExtraRows_length]; exact hk
  have e' : indRecRows[proAxmRowCount + k]? = indRecExtraRows[k]? := by
    unfold indRecRows
    rw [List.getElem?_append_right (by rw [proAxmRows_length]; omega), proAxmRows_length, Nat.add_sub_cancel_left]
  have e : indRecRows[proAxmRowCount + k]'hlt = indRecExtraRows[k]'hk' := by
    rw [List.getElem?_eq_getElem hlt, List.getElem?_eq_getElem hk'] at e'
    exact Option.some.inj e'
  rw [e] at hr
  exact ⟨lt_of_lt_of_le (by exact_mod_cast hlt) (indRecRows_length ▸ h.1), hr.1, hr.2⟩

