  Lib.pa_proves_of_models fun _ _ _ ↦ models_isRelOR_lt.mpr (isRel_LOR_iff_V.mpr (Or.inr ⟨rfl, rfl⟩))
theorem lib_isRelOR_lt : Lib isRelOR_lt := Lib.of_pa pa_proves_isRelOR_lt

end indRecPre

/-! ## 1. The new library rows (`Lib`) -/

section indRecLib

/-- `z < n → t = #z → BsT n (z + 1) t`. -/
noncomputable def bsBvarB : ArithmeticSemisentence 3 :=
