/-! ### The per-row applicability lemmas `iok_<row>` (against explicit table readings) -/

/-- Row `qqAllsZero` as a step, against the table readings `hlen`/`hrow` at its index. -/
lemma iok_qqAllsZero {tbl N E Γ W : V} {wb : V} (htbl : TableOK tbl N) (hWp : W = indRecPieces)
    (hlen : ((iIdx_qqAllsZero : ℕ) : V) < len tbl)
    (hrow : rowM tbl.[((iIdx_qqAllsZero : ℕ) : V)] = ((1 : ℕ) : V) ∧
      rowB tbl.[((iIdx_qqAllsZero : ℕ) : V)] = impChainV LAct (vecOf row_qqAllsZero_as) row_qqAllsZero_c)
    (hΓ : IsFormulaSet LAct Γ) (hwb : IsSemiterm LAct 0 wb) (hEwb : termLen LAct wb ≤ E)  :
    StepOK tbl E ((8 : ℕ) : V) Γ (mkStep W ((iIdx_qqAllsZero : ℕ) : V) ?[wb]) ∧ sTag (mkStep W ((iIdx_qqAllsZero : ℕ) : V) ?[wb]) = 0 ∧
    ctxAfter Γ (mkStep W ((iIdx_qqAllsZero : ℕ) : V) ?[wb]) = insert (neg LAct (allsFact wb wb (𝟎 : V))) Γ := by
  subst hWp
  have hstep := imk_qqAllsZero (V := V) ?[wb]
  have hes : ∀ e ∈ ([wb] : List V), IsSemiterm LAct 0 e ∧ termLen LAct e ≤ E := List.forall_mem_cons.mpr ⟨⟨hwb, hEwb⟩, List.forall_mem_nil _⟩
  have hinst := inst_qqAllsZero hwb
  rw [hstep, show (?[wb] : V) = vecOf [wb] from rfl]
  refine ⟨stepOK_useHorn htbl [wb] row_qqAllsZero_as hΓ hlen hrow.1 hrow.2 (by exact_mod_cast (by decide : 1 ≤ 8))
    (by rw [show row_qqAllsZero_as.length = 0 from rfl] <;> exact_mod_cast (by decide : 0 ≤ 8)) hes ?_, by simp, ?_⟩
  · exact neg_mem_of_map hinst.1 (List.forall_mem_nil _)
  · rw [ctxAfter_useHorn [wb] row_qqAllsZero_as isSemiformula_qqAllsZero_c (fun e he ↦ (hes e he).1), hinst.2]

/-- Row `qqAllsSucc` as a step, against the table readings `hlen`/`hrow` at its index. -/
lemma iok_qqAllsSucc {tbl N E Γ W : V} {wm wb wp wpp : V} (htbl : TableOK tbl N) (hWp : W = indRecPieces)
    (hlen : ((iIdx_qqAllsSucc : ℕ) : V) < len tbl)
    (hrow : rowM tbl.[((iIdx_qqAllsSucc : ℕ) : V)] = ((4 : ℕ) : V) ∧
      rowB tbl.[((iIdx_qqAllsSucc : ℕ) : V)] = impChainV LAct (vecOf row_qqAllsSucc_as) row_qqAllsSucc_c)
    (hΓ : IsFormulaSet LAct Γ) (hwm : IsSemiterm LAct 0 wm) (hEwm : termLen LAct wm ≤ E) (hwb : IsSemiterm LAct 0 wb) (hEwb : termLen LAct wb ≤ E) (hwp : IsSemiterm LAct 0 wp) (hEwp : termLen LAct wp ≤ E) (hwpp : IsSemiterm LAct 0 wpp) (hEwpp : termLen LAct wpp ≤ E) (hmem0 : neg LAct (allsFact wp wb wm) ∈ Γ) (hmem1 : neg LAct (allFact wpp wp) ∈ Γ) :
    StepOK tbl E ((8 : ℕ) : V) Γ (mkStep W ((iIdx_qqAllsSucc : ℕ) : V) ?[wm, wb, wp, wpp]) ∧ sTag (mkStep W ((iIdx_qqAllsSucc : ℕ) : V) ?[wm, wb, wp, wpp]) = 0 ∧
    ctxAfter Γ (mkStep W ((iIdx_qqAllsSucc : ℕ) : V) ?[wm, wb, wp, wpp]) = insert (neg LAct (allsFact wpp wb (wm ^+ (𝟏 : V)))) Γ := by
  subst hWp
  have hstep := imk_qqAllsSucc (V := V) ?[wm, wb, wp, wpp]
  have hes : ∀ e ∈ ([wm, wb, wp, wpp] : List V), IsSemiterm LAct 0 e ∧ termLen LAct e ≤ E := List.forall_mem_cons.mpr ⟨⟨hwm, hEwm⟩, List.forall_mem_cons.mpr ⟨⟨hwb, hEwb⟩, List.forall_mem_cons.mpr ⟨⟨hwp, hEwp⟩, List.forall_mem_cons.mpr ⟨⟨hwpp, hEwpp⟩, List.forall_mem_nil _⟩⟩⟩⟩
  have hinst := inst_qqAllsSucc hwm hwb hwp hwpp
  rw [hstep, show (?[wm, wb, wp, wpp] : V) = vecOf [wm, wb, wp, wpp] from rfl]
  refine ⟨stepOK_useHorn htbl [wm, wb, wp, wpp] row_qqAllsSucc_as hΓ hlen hrow.1 hrow.2 (by exact_mod_cast (by decide : 4 ≤ 8))
    (by rw [show row_qqAllsSucc_as.length = 2 from rfl] <;> exact_mod_cast (by decide : 2 ≤ 8)) hes ?_, by simp, ?_⟩
  · exact neg_mem_of_map hinst.1 (List.forall_mem_cons.mpr ⟨hmem0, List.forall_mem_cons.mpr ⟨hmem1, List.forall_mem_nil _⟩⟩)
  · rw [ctxAfter_useHorn [wm, wb, wp, wpp] row_qqAllsSucc_as isSemiformula_qqAllsSucc_c (fun e he ↦ (hes e he).1), hinst.2]

