/-! ## 0. The new library row (`Lib`) -/

section numIdLib

/-- `1 ≤ m → s = binNumeral (2 * m) → u = s ^+ 𝟏 (as `func`/`∷` facts) → u = binNumeral (2 * m + 1)` — the odd bit-step THROUGH the even numeral (`binNumeralOddCert` has 12 witnesses, above the cap `M = 9`). -/
noncomputable def binNumeralOddOfEvenB : ArithmeticSemisentence 6 :=
  “u x x' s one m. 1 ≤ m → !binNumeralGraph s (2 * m) → !qqFuncDef one 0 (0 + 1) 0 → !adjoinDef x' one 0 → !adjoinDef x s x' → !qqFuncDef u (0 + 1 + 1) 0 x → !binNumeralGraph u ((2 * m) + 1)”
noncomputable def binNumeralOddOfEven : ArithmeticSentence := ∀¹* binNumeralOddOfEvenB
lemma models_binNumeralOddOfEven : V↓[ℒₒᵣ] ⊧ binNumeralOddOfEven ↔ ∀ u x x' s one m : V, (1 : V) ≤ m → s = binNumeral ((2 : V) * m) → one = ^func (0 : V) ((0 : V) + 1) (0 : V) → x' = one ∷ (0 : V) → x = s ∷ x' → u = ^func ((0 : V) + 1 + 1) (0 : V) x → u = binNumeral (((2 : V) * m) + (1 : V)) := by
  simp [binNumeralOddOfEven, binNumeralOddOfEvenB, models_iff, Matrix.vecForall_iff, binNumeral.defined.iff]
theorem pa_proves_binNumeralOddOfEven : 𝗣𝗔 ⊢ binNumeralOddOfEven :=
  Lib.pa_proves_of_models fun _ _ _ ↦ models_binNumeralOddOfEven.mpr fun _ _ _ _ _ _ h₁ h₂ h₃ h₄ h₅ h₆ ↦ by subst_vars; rw [binNumeral_two_mul_add_one h₁, ← binNumeral_two_mul h₁]; simp only [qqAdd, coe_addIndex_eq, Arithmetic.one, qqFuncN_eq_qqFunc, qqFunc_absolute, coe_oneIndex_eq, Nat.cast_zero, zero_add, one_add_one_eq_two]
theorem lib_binNumeralOddOfEven : Lib binNumeralOddOfEven := Lib.of_pa pa_proves_binNumeralOddOfEven

end numIdLib

/-! ## 1. Its `quote_row_`/`inst_` block (the `RowInstB` template) -/

section numIdRowInst

/-! ### `binNumeralOddOfEven` — `“u x x' s one m. …”`, `m = 6` -/

noncomputable def row_binNumeralOddOfEven_as : List V := [subst LAct (listToVec [(𝟏 : V), bv 5]) Ple, subst LAct (listToVec [bv 3, (((𝟏 : V) ^+ (𝟏 : V)) ^* bv 5)]) Pbnum, subst LAct (listToVec [bv 4, (𝟎 : V), cT 1, (𝟎 : V)]) Pfunc, subst LAct (listToVec [bv 2, bv 4, (𝟎 : V)]) Padjoin, subst LAct (listToVec [bv 1, bv 3, bv 2]) Padjoin, subst LAct (listToVec [bv 0, cT 2, (𝟎 : V), bv 1]) Pfunc]
noncomputable def row_binNumeralOddOfEven_c : V := subst LAct (listToVec [bv 0, ((((𝟏 : V) ^+ (𝟏 : V)) ^* bv 5) ^+ (𝟏 : V))]) Pbnum

theorem quote_row_binNumeralOddOfEven : (⌜Semiformula.lMap emb binNumeralOddOfEvenB⌝ : V) = impChain LAct row_binNumeralOddOfEven_as row_binNumeralOddOfEven_c := by
  unfold binNumeralOddOfEvenB row_binNumeralOddOfEven_as row_binNumeralOddOfEven_c Padjoin Pbnum Pfunc Ple leS
  all_goals row_shapeB

lemma isSemiformula_binNumeralOddOfEven_c : IsSemiformula LAct ((6 : ℕ) : V) row_binNumeralOddOfEven_c := by
  unfold row_binNumeralOddOfEven_c
  exact isSemiformula_substRow isSemiformula_Pbnum _ (by rfl) (by row_entriesB)

/-- `binNumeralOddOfEven` at the witnesses `[wm, wone, ws, wxp, wx, wu]` (the DSL variables right-to-left). -/
lemma inst_binNumeralOddOfEven {wm wone ws wxp wx wu : V} (hwm : IsSemiterm LAct 0 wm) (hwone : IsSemiterm LAct 0 wone) (hws : IsSemiterm LAct 0 ws) (hwxp : IsSemiterm LAct 0 wxp) (hwx : IsSemiterm LAct 0 wx) (hwu : IsSemiterm LAct 0 wu) :
    row_binNumeralOddOfEven_as.map (instOuter LAct [wm, wone, ws, wxp, wx, wu]) = [leFact (𝟏 : V) wm, binNumeralFact ws (((𝟏 : V) ^+ (𝟏 : V)) ^* wm), funcFact wone (𝟎 : V) (cT 1) (𝟎 : V), adjFact wxp wone (𝟎 : V), adjFact wx ws wxp, funcFact wu (cT 2) (𝟎 : V) wx] ∧
    instOuter LAct [wm, wone, ws, wxp, wx, wu] row_binNumeralOddOfEven_c = binNumeralFact wu ((((𝟏 : V) ^+ (𝟏 : V)) ^* wm) ^+ (𝟏 : V)) := by
  have hes : ∀ e ∈ ([wm, wone, ws, wxp, wx, wu] : List V), IsSemiterm LAct 0 e := (List.forall_mem_cons.mpr ⟨hwm, List.forall_mem_cons.mpr ⟨hwone, List.forall_mem_cons.mpr ⟨hws, List.forall_mem_cons.mpr ⟨hwxp, List.forall_mem_cons.mpr ⟨hwx, List.forall_mem_cons.mpr ⟨hwu, List.forall_mem_nil _⟩⟩⟩⟩⟩⟩)
  unfold row_binNumeralOddOfEven_as row_binNumeralOddOfEven_c
  simp only [List.map_cons, List.map_nil]
  rw [instOuter_subst_listToVec _ isSemiformula_Ple (by rfl) _ hes (by row_entriesB), instOuter_subst_listToVec _ isSemiformula_Pbnum (by rfl) _ hes (by row_entriesB), instOuter_subst_listToVec _ isSemiformula_Pfunc (by rfl) _ hes (by row_entriesB), instOuter_subst_listToVec _ isSemiformula_Padjoin (by rfl) _ hes (by row_entriesB), instOuter_subst_listToVec _ isSemiformula_Padjoin (by rfl) _ hes (by row_entriesB), instOuter_subst_listToVec _ isSemiformula_Pfunc (by rfl) _ hes (by row_entriesB), instOuter_subst_listToVec _ isSemiformula_Pbnum (by rfl) _ hes (by row_entriesB)]
  all_goals try row_entries_simpB
  row_finish

