/-! ### The per-row applicability lemmas `nok_<row>` (against explicit table readings) -/

/-- Row `instBIntro` as a step, against the table readings `hlen`/`hrow` at its index. -/
lemma nok_instBIntro {tbl N E Γ W : V} {wn wk wt wv wg : V} (htbl : TableOK tbl N) (hWp : W = numIdPieces)
    (hlen : ((nIdx_instBIntro : ℕ) : V) < len tbl)
    (hrow : rowM tbl.[((nIdx_instBIntro : ℕ) : V)] = ((5 : ℕ) : V) ∧
      rowB tbl.[((nIdx_instBIntro : ℕ) : V)] = impChainV LAct (vecOf row_instBIntro_as) row_instBIntro_c)
    (hΓ : IsFormulaSet LAct Γ) (hwn : IsSemiterm LAct 0 wn) (hEwn : termLen LAct wn ≤ E) (hwk : IsSemiterm LAct 0 wk) (hEwk : termLen LAct wk ≤ E) (hwt : IsSemiterm LAct 0 wt) (hEwt : termLen LAct wt ≤ E) (hwv : IsSemiterm LAct 0 wv) (hEwv : termLen LAct wv ≤ E) (hwg : IsSemiterm LAct 0 wg) (hEwg : termLen LAct wg ≤ E) (hmem0 : neg LAct (bnumFact wt wk) ∈ Γ) (hmem1 : neg LAct (adjFact wv wt (𝟎 : V)) ∈ Γ) (hmem2 : neg LAct (substFact wg wv wn) ∈ Γ) :
    StepOK tbl E ((8 : ℕ) : V) Γ (mkStep W ((nIdx_instBIntro : ℕ) : V) ?[wn, wk, wt, wv, wg]) ∧ sTag (mkStep W ((nIdx_instBIntro : ℕ) : V) ?[wn, wk, wt, wv, wg]) = 0 ∧
    ctxAfter Γ (mkStep W ((nIdx_instBIntro : ℕ) : V) ?[wn, wk, wt, wv, wg]) = insert (neg LAct (instBFact wg wn wk)) Γ := by
  subst hWp
  have hstep := nmk_instBIntro (V := V) ?[wn, wk, wt, wv, wg]
  have hes : ∀ e ∈ [wn, wk, wt, wv, wg], IsSemiterm LAct 0 e ∧ termLen LAct e ≤ E := List.forall_mem_cons.mpr ⟨⟨hwn, hEwn⟩, List.forall_mem_cons.mpr ⟨⟨hwk, hEwk⟩, List.forall_mem_cons.mpr ⟨⟨hwt, hEwt⟩, List.forall_mem_cons.mpr ⟨⟨hwv, hEwv⟩, List.forall_mem_cons.mpr ⟨⟨hwg, hEwg⟩, List.forall_mem_nil _⟩⟩⟩⟩⟩
  have hinst := inst_instBIntro hwn hwk hwt hwv hwg
  rw [hstep, show (?[wn, wk, wt, wv, wg] : V) = vecOf [wn, wk, wt, wv, wg] from rfl]
  refine ⟨stepOK_useHorn htbl [wn, wk, wt, wv, wg] row_instBIntro_as hΓ hlen hrow.1 hrow.2 (by exact_mod_cast (by decide : 5 ≤ 8))
    (by rw [show row_instBIntro_as.length = 3 from rfl] <;> exact_mod_cast (by decide : 3 ≤ 8)) hes ?_, by simp, ?_⟩
  · exact neg_mem_of_map hinst.1 (List.forall_mem_cons.mpr ⟨hmem0, List.forall_mem_cons.mpr ⟨hmem1, List.forall_mem_cons.mpr ⟨hmem2, List.forall_mem_nil _⟩⟩⟩)
  · rw [ctxAfter_useHorn [wn, wk, wt, wv, wg] row_instBIntro_as isSemiformula_instBIntro_c (fun e he ↦ (hes e he).1), hinst.2]

/-- Row `congSubstArg` as a step, against the table readings `hlen`/`hrow` at its index. -/
lemma nok_congSubstArg {tbl N E Γ W : V} {wy ww wn wnp : V} (htbl : TableOK tbl N) (hWp : W = numIdPieces)
    (hlen : ((nIdx_congSubstArg : ℕ) : V) < len tbl)
    (hrow : rowM tbl.[((nIdx_congSubstArg : ℕ) : V)] = ((4 : ℕ) : V) ∧
