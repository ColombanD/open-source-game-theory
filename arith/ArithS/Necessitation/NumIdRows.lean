/-! ## 0. The new library row (`Lib`) -/

section numIdLib

/-- `1 ≤ m → s = bnum (2 * m) → u = s ^+ 𝟏 (as `func`/`∷` facts) → u = bnum (2 * m + 1)` — the odd bit-step THROUGH the even numeral (`bnumOddCert` has 12 witnesses, above the cap `M = 9`). -/
noncomputable def bnumOddOfEvenB : ArithmeticSemisentence 6 :=
  “u x x' s one m. 1 ≤ m → !bnumGraph s (2 * m) → !qqFuncDef one 0 (0 + 1) 0 → !adjoinDef x' one 0 → !adjoinDef x s x' → !qqFuncDef u (0 + 1 + 1) 0 x → !bnumGraph u ((2 * m) + 1)”
noncomputable def bnumOddOfEven : ArithmeticSentence := ∀¹* bnumOddOfEvenB
lemma models_bnumOddOfEven : V↓[ℒₒᵣ] ⊧ bnumOddOfEven ↔ ∀ u x x' s one m : V, (1 : V) ≤ m → s = bnum ((2 : V) * m) → one = ^func (0 : V) ((0 : V) + 1) (0 : V) → x' = one ∷ (0 : V) → x = s ∷ x' → u = ^func ((0 : V) + 1 + 1) (0 : V) x → u = bnum (((2 : V) * m) + (1 : V)) := by
  simp [bnumOddOfEven, bnumOddOfEvenB, models_iff, Matrix.vecForall_iff, bnum.defined.iff]
theorem pa_proves_bnumOddOfEven : 𝗣𝗔 ⊢ bnumOddOfEven :=
  Lib.pa_proves_of_models fun _ _ _ ↦ models_bnumOddOfEven.mpr fun _ _ _ _ _ _ h₁ h₂ h₃ h₄ h₅ h₆ ↦ by subst_vars; rw [bnum_two_mul_add_one h₁, ← bnum_two_mul h₁]; simp only [qqAdd, coe_addIndex_eq, Arithmetic.one, qqFuncN_eq_qqFunc, qqFunc_absolute, coe_oneIndex_eq, Nat.cast_zero, zero_add, one_add_one_eq_two]
theorem lib_bnumOddOfEven : Lib bnumOddOfEven := Lib.of_pa pa_proves_bnumOddOfEven

end numIdLib

/-! ## 1. Its `quote_row_`/`inst_` block (the `RowInstB` template) -/

section numIdRowInst

/-! ### `bnumOddOfEven` — `“u x x' s one m. …”`, `m = 6` -/

noncomputable def row_bnumOddOfEven_as : List V := [subst LAct (listToVec [(𝟏 : V), bv 5]) Ple, subst LAct (listToVec [bv 3, (((𝟏 : V) ^+ (𝟏 : V)) ^* bv 5)]) Pbnum, subst LAct (listToVec [bv 4, (𝟎 : V), cT 1, (𝟎 : V)]) Pfunc, subst LAct (listToVec [bv 2, bv 4, (𝟎 : V)]) Padjoin, subst LAct (listToVec [bv 1, bv 3, bv 2]) Padjoin, subst LAct (listToVec [bv 0, cT 2, (𝟎 : V), bv 1]) Pfunc]
