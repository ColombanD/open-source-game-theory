/-- A zero pad over the certification tail (whose rows are used only through re-indexed lists and have no pieces). -/
noncomputable def numIdPadPieceList : List V := List.replicate (certRowCount - walkRowCount) (0 : V)

/-- **The piece table of the pin**: the prologue's pieces, the pad, then the extra rows' pieces. -/
noncomputable def numIdPieces : V := vecOf (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList ++ frag2ExtraPieceList ++ topExtraPieceList ++ proExtraPieceList ++ numIdPadPieceList ++ numIdExtraPieceList)

lemma numIdPieces_nth_lt (i : ℕ) (hi : i < proBase) : (numIdPieces : V).[(i : V)] = (proPieces : V).[(i : V)] := by
  unfold numIdPieces proPieces
  have h1 : i < (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList ++ frag2ExtraPieceList ++ topExtraPieceList ++ proExtraPieceList ++ numIdPadPieceList ++ numIdExtraPieceList : List V).length := by
    rw [show (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList ++ frag2ExtraPieceList ++ topExtraPieceList ++ proExtraPieceList ++ numIdPadPieceList ++ numIdExtraPieceList : List V).length = numIdRowCount from rfl]
    exact lt_of_lt_of_le hi (by simp only [numIdRowCount, proRowCount]; omega)
  have h2 : i < (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList ++ frag2ExtraPieceList ++ topExtraPieceList ++ proExtraPieceList : List V).length := by
    rw [show (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList ++ frag2ExtraPieceList ++ topExtraPieceList ++ proExtraPieceList : List V).length = proBase from rfl]; exact hi
  have h3 : i < (walkPieceList ++ layoutExtraPieceList ++ frag1ExtraPieceList ++ frag2ExtraPieceList ++ topExtraPieceList ++ proExtraPieceList ++ numIdPadPieceList : List V).length := by
    rw [List.length_append]; exact lt_of_lt_of_le h2 (Nat.le_add_right _ _)
  rw [nth_vecOf _ i h1, nth_vecOf _ i h2]
  exact (List.getElem_append_left h3).trans (List.getElem_append_left h2)

/-- A prologue step read from the pin's pieces is the prologue's step. -/
lemma mkStep_numIdPieces_lt (i : ℕ) (hi : i < proBase) (ev : V) :
    mkStep numIdPieces (i : V) ev = mkStep proPieces (i : V) ev := by
  rw [mkStep, mkStep, numIdPieces_nth_lt i hi]

