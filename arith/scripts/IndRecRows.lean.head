import ArithS.Necessitation.ProAxmRows

/-!
# ArithS.Necessitation.IndRecRows — the induction-instance recognizer's rows (GENERATED by `arith/scripts/gen_indrec.py`)

The rows `IndRec.lean` (case (ii) of the `axm` prologue, `ProAxm.lean`'s `AxmIndOracle`) needs beyond the `axm`
table, and the Σ₁ predicates they speak (§0, hand-written in `scripts/IndRecRows.lean.head`):

* `BsT n m t` / `BsV n m k v` / `BsF n m p` — `ℒₒᵣ`-formation AND the exact bound-variable count in ONE pass
  (`IsSemiterm ℒₒᵣ n t ∧ m = termBV t`, `IsSemitermVec ℒₒᵣ k n v ∧ m = listMax (termBVVec k v)`,
  `IsSemiformula ℒₒᵣ n p ∧ m = bv p`); the rows `bs*` compute them bottom-up with the `max` of two chain
  numerals decided by a `≤` fact (`bsAndL/R`, `bsVAdjL/R`) and `bv (∀ p) = bv p - 1` by the two shapes
  `bsAllS` (`mp + 1 ↦ mp`) / `bsAllZ` (`0 ↦ 0`) — no `max`/`-` graph facts;
* `FvSeq w j m` — `w = ⟨&j, …, &(m-1)⟩` (`fvSeqNil/Cons`; at `j = 0` it is `fvarVec m`);
* `IsC0 c`/`IsC1 c` — the two constant substitution vectors `⟨⌜0⌝⟩`/`⟨⌜#0 + 1⌝⟩` by their shape facts;
* `BodyShape s x ns K` / `IndBodyL s K` — the induction body `K(0) → (∀ (K → K(#0+1))) → ∀ K` in the
  NEGATION-NORMAL shape the walk of the code exposes (`s = x ⋎ ((∃ (K ⋏ ns)) ⋎ (∀ K))`, `x = subst c0 (neg K)`,
  `ns = subst c1 (neg K)`);
* **`indRecL`** — the recognizer: `qqAllsDef p b m → bsF m m b → shiftGraph LAct b b → fvSeq fv 0 m →
  substsGraph LAct s fv b → indBodyL s K → Δ₁ch TAct p`, every hypothesis an `LAct`-fact at eigenvariables; its
  truth is `inductionR_of_L`, the ONLY use of `Lib/Bridge.lean`'s language invariance (semantic, never as a row):
  the `ℒₒᵣ`-ness of `K` follows from that of `s = subst (fvarVec m) b`, so ONE formation pass (over `b`) suffices.

The six CLOSED `ℒₒᵣ` symbol rows (`isFuncOR_zero/one/add/mul`, `isRelOR_eq/lt`) mirror `Lib/Walk.lean`'s `LAct`
ones (chain-numeral arities and codes). The extra rows `indRecExtraRows` sit at `iIdx_<row> = proAxmRowCount + k`
(APPEND-ONLY after the `axm` table, SYMBOLIC in `proAxmRowCount`); the piece table `indRecPieces` extends
`proAxmPieces` entrywise; per row `imk_`/`itag_`/`iok_` against EXPLICIT table readings; `IndRecTable` lives in
`IndRec.lean`.
-/

namespace ArithS

open FFL FFL.FirstOrder Arithmetic Bootstrapping
open PeanoMinus ISigma0 ISigma1
open FFL.FirstOrder.Arithmetic.Bootstrapping.Arithmetic
open LAct

variable {V : Type} [ORingStructure V] [V↓[ℒₒᵣ] ⊧* 𝗜𝚺₁]

set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

/-! ## 0. The Σ₁ predicates, their codes, and the recognizer's truth (hand-written) -/

section indRecPre

/-- `BsT n m t`: `t` is an `ℒₒᵣ`-term at bound `n` with `termBV t = m`. -/
def BsT (n m t : V) : Prop := IsSemiterm ℒₒᵣ n t ∧ m = termBV ℒₒᵣ t
noncomputable def bsTDef : 𝚺₁.Semisentence 3 := .mkSigma “n m t. !(isSemiterm ℒₒᵣ).sigma n t ∧ !(termBVGraph ℒₒᵣ) m t”
instance bsT_defined : 𝚺₁-Relation₃ (BsT : V → V → V → Prop) via bsTDef := .mk fun v ↦ by
  simp [bsTDef, BsT, termBV.defined.iff]
instance bsT_definable : 𝚺₁-Relation₃ (BsT : V → V → V → Prop) := bsT_defined.to_definable

/-- `BsV n m k v`: `v` is an `ℒₒᵣ`-term vector (length `k`, bound `n`) with `listMax (termBVVec k v) = m`. -/
def BsV (n m k v : V) : Prop := IsSemitermVec ℒₒᵣ k n v ∧ m = listMax (termBVVec ℒₒᵣ k v)
noncomputable def bsVDef : 𝚺₁.Semisentence 4 :=
  .mkSigma “n m k v. !(isSemitermVec ℒₒᵣ).sigma k n v ∧ ∃ M, !(termBVVecGraph ℒₒᵣ) M k v ∧ !listMaxDef m M”
instance bsV_defined : 𝚺₁-Relation₄ (BsV : V → V → V → V → Prop) via bsVDef := .mk fun v ↦ by
  simp [bsVDef, BsV, termBVVec.defined.iff, listMax_defined.iff]
instance bsV_definable : 𝚺₁-Relation₄ (BsV : V → V → V → V → Prop) := bsV_defined.to_definable

/-- `BsF n m p`: `p` is an `ℒₒᵣ`-formula at bound `n` with `bv p = m`. -/
def BsF (n m p : V) : Prop := IsSemiformula ℒₒᵣ n p ∧ m = Bootstrapping.bv ℒₒᵣ p
noncomputable def bsFDef : 𝚺₁.Semisentence 3 := .mkSigma “n m p. !(isSemiformula ℒₒᵣ).sigma n p ∧ !(bvGraph ℒₒᵣ) m p”
instance bsF_defined : 𝚺₁-Relation₃ (BsF : V → V → V → Prop) via bsFDef := .mk fun v ↦ by
  simp [bsFDef, BsF, bv.defined.iff]
instance bsF_definable : 𝚺₁-Relation₃ (BsF : V → V → V → Prop) := bsF_defined.to_definable

/-- `FvSeq w j m`: `w = ⟨&j, …, &(m-1)⟩`. -/
def FvSeq (w j m : V) : Prop := j ≤ m ∧ len w + j = m ∧ ∀ i < len w, w.[i] = ^&(j + i)
noncomputable def fvSeqDef : 𝚺₁.Semisentence 3 :=
  .mkSigma “w j m. j ≤ m ∧ ∃ l, !lenDef l w ∧ l + j = m ∧ ∀ i < l, ∃ e, !nthDef e w i ∧ !qqFvarDef e (j + i)”
instance fvSeq_defined : 𝚺₁-Relation₃ (FvSeq : V → V → V → Prop) via fvSeqDef := .mk fun v ↦ by
  simp [fvSeqDef, FvSeq]
instance fvSeq_definable : 𝚺₁-Relation₃ (FvSeq : V → V → V → Prop) := fvSeq_defined.to_definable

/-- `IsC0 c`: `c = ⟨⌜0⌝⟩`, the substitution vector of the base case. -/
def IsC0 (c : V) : Prop := ∃ t, t = ^func 0 0 0 ∧ c = t ∷ 0
noncomputable def isC0Def : 𝚺₁.Semisentence 1 := .mkSigma “c. ∃ t, !qqFuncDef t 0 0 0 ∧ !adjoinDef c t 0”
instance isC0_defined : 𝚺₁-Predicate (IsC0 : V → Prop) via isC0Def := .mk fun v ↦ by
  simp [isC0Def, IsC0]
instance isC0_definable : 𝚺₁-Predicate (IsC0 : V → Prop) := isC0_defined.to_definable

/-- `IsC1 c`: `c = ⟨⌜#0 + 1⌝⟩`, the substitution vector of the step case. -/
def IsC1 (c : V) : Prop :=
  ∃ t v2 x v1 o, o = ^func 0 (0 + 1) 0 ∧ v1 = o ∷ 0 ∧ x = ^#0 ∧ v2 = x ∷ v1 ∧ t = ^func (0 + 1 + 1) 0 v2 ∧ c = t ∷ 0
noncomputable def isC1Def : 𝚺₁.Semisentence 1 := .mkSigma
  “c. ∃ t v2 x v1 o, !qqFuncDef o 0 (0 + 1) 0 ∧ !adjoinDef v1 o 0 ∧ !qqBvarDef x 0 ∧ !adjoinDef v2 x v1 ∧
    !qqFuncDef t (0 + 1 + 1) 0 v2 ∧ !adjoinDef c t 0”
instance isC1_defined : 𝚺₁-Predicate (IsC1 : V → Prop) via isC1Def := .mk fun v ↦ by
  simp [isC1Def, IsC1]
instance isC1_definable : 𝚺₁-Predicate (IsC1 : V → Prop) := isC1_defined.to_definable

/-- `BodyShape s x ns K`: `s = x ⋎ ((∃ (K ⋏ ns)) ⋎ (∀ K))`. -/
def BodyShape (s x ns K : V) : Prop :=
  ∃ y u z n1, s = x ^⋎ y ∧ y = u ^⋎ z ∧ u = ^∃ n1 ∧ n1 = K ^⋏ ns ∧ z = ^∀ K
noncomputable def bodyShapeDef : 𝚺₁.Semisentence 4 := .mkSigma
  “s x ns K. ∃ y u z n1, !qqOrDef s x y ∧ !qqOrDef y u z ∧ !qqExsDef u n1 ∧ !qqAndDef n1 K ns ∧ !qqAllDef z K”
instance bodyShape_defined : 𝚺₁-Relation₄ (BodyShape : V → V → V → V → Prop) via bodyShapeDef := .mk fun v ↦ by
  simp [bodyShapeDef, BodyShape]
instance bodyShape_definable : 𝚺₁-Relation₄ (BodyShape : V → V → V → V → Prop) := bodyShape_defined.to_definable

/-- `IndBodyL s K`: `s` is the induction body of `K`, read in the `LAct` vocabulary. -/
def IndBodyL (s K : V) : Prop :=
  ∃ x ns nk c0 c1, BodyShape s x ns K ∧ nk = neg LAct K ∧ IsC0 c0 ∧ x = subst LAct c0 nk ∧ IsC1 c1 ∧ ns = subst LAct c1 nk
noncomputable def indBodyLDef : 𝚺₁.Semisentence 2 := .mkSigma
  “s K. ∃ x ns nk c0 c1, !bodyShapeDef s x ns K ∧ !(negGraph LAct) nk K ∧ !isC0Def c0 ∧ !(substsGraph LAct) x c0 nk ∧
    !isC1Def c1 ∧ !(substsGraph LAct) ns c1 nk”
instance indBodyL_defined : 𝚺₁-Relation (IndBodyL : V → V → Prop) via indBodyLDef := .mk fun v ↦ by
  simp [indBodyLDef, IndBodyL, bodyShape_defined.iff, isC0_defined.iff, isC1_defined.iff, neg.defined.iff, subst.defined.iff]
instance indBodyL_definable : 𝚺₁-Relation (IndBodyL : V → V → Prop) := indBodyL_defined.to_definable

/-! ### The codes of the small constants -/

lemma coe_zero_eq : ((𝟎 : ℕ) : V) = ^func 0 0 0 := by
  simp [Arithmetic.zero, qqFunc_absolute, qqFuncN_eq_qqFunc, coe_zeroIndex_eq]

lemma coe_one_eq : ((𝟏 : ℕ) : V) = ^func 0 (0 + 1) 0 := by
  simp [Arithmetic.one, qqFunc_absolute, qqFuncN_eq_qqFunc, coe_oneIndex_eq]

lemma qqAdd_eq (x y : V) : x ^+ y = ^func (0 + 1 + 1) 0 (x ∷ y ∷ 0) := by
  simp [qqAdd, coe_addIndex_eq, one_add_one_eq_two]

/-- The code of the base-case substitution vector. -/
lemma isC0_val {c : V} (h : IsC0 c) :
    c = SemitermVec.val (![⌜(‘0’ : ArithmeticSemiterm ℕ 0)⌝] : SemitermVec V ℒₒᵣ 1 0) := by
  obtain ⟨t, rfl, rfl⟩ := h
  simp [SemitermVec.val, matrixToVec, coe_zero_eq]

/-- The code of the step-case substitution vector. -/
lemma isC1_val {c : V} (h : IsC1 c) :
    c = SemitermVec.val (![⌜(‘#0 + 1’ : ArithmeticSemiterm ℕ 1)⌝] : SemitermVec V ℒₒᵣ 1 1) := by
  obtain ⟨t, v2, x, v1, o, rfl, rfl, rfl, rfl, rfl, rfl⟩ := h
  simp [SemitermVec.val, matrixToVec, coe_one_eq, qqAdd_eq]

lemma isC0_isSemitermVec {c : V} (h : IsC0 c) : IsSemitermVec ℒₒᵣ 1 0 c := by
  rw [isC0_val h]
  simpa using SemitermVec.isSemitermVec (![⌜(‘0’ : ArithmeticSemiterm ℕ 0)⌝] : SemitermVec V ℒₒᵣ 1 0)
lemma isC1_isSemitermVec {c : V} (h : IsC1 c) : IsSemitermVec ℒₒᵣ 1 1 c := by
  rw [isC1_val h]
  simpa using SemitermVec.isSemitermVec (![⌜(‘#0 + 1’ : ArithmeticSemiterm ℕ 1)⌝] : SemitermVec V ℒₒᵣ 1 1)

/-! ### `FvSeq` -/

/-- `FvSeq w 0 m → w = fvarVec m`. -/
lemma FvSeq.eq_fvarVec {w m : V} (h : FvSeq w 0 m) : w = Bootstrapping.fvarVec m := by
  obtain ⟨_, hl, hn⟩ := h
  rw [add_zero] at hl
  refine nth_ext' m hl (Bootstrapping.len_fvarVec m) fun i hi ↦ ?_
  rw [Bootstrapping.nth_fvarVec m i hi, hn i (by rw [hl]; exact hi), zero_add]

/-- The `cons` step of `FvSeq` (the truth of the row `fvSeqCons`). -/
lemma fvSeq_cons {w' t w m j : V} (h₁ : FvSeq w (j + 1) m) (h₂ : t = ^&j) (h₃ : w' = t ∷ w) : FvSeq w' j m := by
  obtain ⟨hjm, hl, hn⟩ := h₁
  subst h₂ h₃
  refine ⟨le_trans le_self_add hjm, by rw [len_adjoin, ← hl]; ring, fun i hi ↦ ?_⟩
  rw [len_adjoin] at hi
  rcases zero_or_succ i with rfl | ⟨i, rfl⟩
  · simp
  · rw [nth_adjoin_succ, hn i (lt_of_add_lt_add_right hi)]
    congr 1; ring

/-! ### The recognizer's truth -/

/-- **The recognizer is sound**: the `LAct`-vocabulary facts of `indRecL` make `p` an induction instance of `𝗣𝗔`
(`InductionR`), hence a `TAct`-axiom code. The language bridge (`Lib/Bridge.lean` §A) is used here, semantically. -/
theorem inductionR_of_L {K s fv b m p : V} (h1 : p = qqAlls b m) (h2 : BsF m m b) (h3 : b = shift LAct b)
    (h4 : FvSeq fv 0 m) (h5 : s = subst LAct fv b) (h6 : IndBodyL s K) : p ∈ TAct.Δ₁Class := by
  obtain ⟨hb, hbv⟩ := h2
  have hfv := h4.eq_fvarVec
  subst hfv
  have hfvL : IsSemitermVec ℒₒᵣ m 0 (Bootstrapping.fvarVec m) := fvarVec_isSemitermVec_LOR m
  have hsO : s = subst ℒₒᵣ (Bootstrapping.fvarVec m) b := by
    rw [h5, subst_LAct_eq hb.isUFormula hfvL.isUTermVec]
  have hs0 : IsSemiformula ℒₒᵣ 0 s := by rw [hsO]; exact IsSemiformula.subst hb hfvL
  obtain ⟨x, ns, nk, c0, c1, ⟨y, u, z, n1, hs1, hy, hu, hn1, hz⟩, hnk, hc0, hx, hc1, hns⟩ := h6
  -- the `ℒₒᵣ`-ness of `K`: a subformula of `s`
  have hK : IsSemiformula ℒₒᵣ 1 K := by
    rw [hs1] at hs0
    have hy0 := (IsSemiformula.or.mp hs0).2
    rw [hy] at hy0
    have hz0 := (IsSemiformula.or.mp hy0).2
    rw [hz] at hz0
    have := IsSemiformula.all.mp hz0
    rwa [zero_add] at this
  have hc0O := isC0_isSemitermVec hc0
  have hc1O := isC1_isSemitermVec hc1
  -- the two substitution instances, in `ℒₒᵣ`
  have hxO : x = neg ℒₒᵣ (subst ℒₒᵣ c0 K) := by
    rw [hx, hnk, substs_neg (IsSemiformula.LAct_of_LOR hK) (IsSemitermVec.LAct_of_LOR hc0O), subst_LAct_eq hK.isUFormula hc0O.isUTermVec,
      neg_LAct_eq (IsSemiformula.subst hK hc0O).isUFormula]
  have hnsO : ns = neg ℒₒᵣ (subst ℒₒᵣ c1 K) := by
    rw [hns, hnk, substs_neg (IsSemiformula.LAct_of_LOR hK) (IsSemitermVec.LAct_of_LOR hc1O), subst_LAct_eq hK.isUFormula hc1O.isUTermVec,
      neg_LAct_eq (IsSemiformula.subst hK hc1O).isUFormula]
  -- the body equation
  have hind : subst ℒₒᵣ (Bootstrapping.fvarVec m) b = indBodyVal K := by
    rw [← hsO, hs1, hy, hu, hn1, hz, hxO, hnsO]
    unfold indBodyVal
    rw [← isC0_val hc0, ← isC1_val hc1]
    simp only [Bootstrapping.imp]
    have hs1K : IsUFormula ℒₒᵣ (subst ℒₒᵣ c1 K) := (IsSemiformula.subst hK hc1O).isUFormula
    have hor : IsUFormula ℒₒᵣ (neg ℒₒᵣ K ^⋎ subst ℒₒᵣ c1 K) := by simp [hK.isUFormula.neg, hs1K]
    rw [neg_all hor, neg_or hK.isUFormula.neg hs1K, IsUFormula.neg_neg hK.isUFormula]
  have hbm : IsSemiformula ℒₒᵣ (0 + m) b := by rw [zero_add]; exact hb
  have hsh : shift ℒₒᵣ b = b := by rw [← shift_LAct_eq hb.isUFormula]; exact h3.symm
  refine mem_TAct_Δ₁Class_of_inductionR (by rw [h1]; exact hbm.qqAlls)
    ⟨m, by rw [h1]; exact index_le_qqAlls _ _, b, by rw [h1]; exact le_qqAlls _ _, h1, hb.isUFormula, hsh, hbv.symm,
      K, ?_, hK, trivial, hind⟩
  rw [hind]; exact le_indBodyVal K

/-! ### The six closed `ℒₒᵣ` symbol rows (`Lib/Walk.lean`'s pattern) -/

/-- `(ℒₒᵣ).IsFunc 0 0` (`0`). -/
noncomputable def isFuncOR_zeroB : ArithmeticSemisentence 0 := “!(ℒₒᵣ).isFunc 0 0”
noncomputable def isFuncOR_zero : ArithmeticSentence := ∀¹* isFuncOR_zeroB
lemma models_isFuncOR_zero : V↓[ℒₒᵣ] ⊧ isFuncOR_zero ↔ (ℒₒᵣ).IsFunc (0 : V) 0 := by
  simp [isFuncOR_zero, isFuncOR_zeroB, models_iff]
theorem pa_proves_isFuncOR_zero : 𝗣𝗔 ⊢ isFuncOR_zero :=
  Lib.pa_proves_of_models fun _ _ _ ↦ models_isFuncOR_zero.mpr (isFunc_LOR_iff_V.mpr (Or.inl ⟨rfl, rfl⟩))
theorem lib_isFuncOR_zero : Lib isFuncOR_zero := Lib.of_pa pa_proves_isFuncOR_zero

/-- `(ℒₒᵣ).IsFunc 0 1` (`1`). -/
noncomputable def isFuncOR_oneB : ArithmeticSemisentence 0 := “!(ℒₒᵣ).isFunc 0 (0 + 1)”
noncomputable def isFuncOR_one : ArithmeticSentence := ∀¹* isFuncOR_oneB
lemma models_isFuncOR_one : V↓[ℒₒᵣ] ⊧ isFuncOR_one ↔ (ℒₒᵣ).IsFunc (0 : V) 1 := by
  simp [isFuncOR_one, isFuncOR_oneB, models_iff]
theorem pa_proves_isFuncOR_one : 𝗣𝗔 ⊢ isFuncOR_one :=
  Lib.pa_proves_of_models fun _ _ _ ↦ models_isFuncOR_one.mpr (isFunc_LOR_iff_V.mpr (Or.inr (Or.inl ⟨rfl, rfl⟩)))
theorem lib_isFuncOR_one : Lib isFuncOR_one := Lib.of_pa pa_proves_isFuncOR_one

/-- `(ℒₒᵣ).IsFunc 2 0` (`+`). -/
noncomputable def isFuncOR_addB : ArithmeticSemisentence 0 := “!(ℒₒᵣ).isFunc (0 + 1 + 1) 0”
noncomputable def isFuncOR_add : ArithmeticSentence := ∀¹* isFuncOR_addB
lemma models_isFuncOR_add : V↓[ℒₒᵣ] ⊧ isFuncOR_add ↔ (ℒₒᵣ).IsFunc (2 : V) 0 := by
  simp [isFuncOR_add, isFuncOR_addB, models_iff]; norm_num
theorem pa_proves_isFuncOR_add : 𝗣𝗔 ⊢ isFuncOR_add :=
  Lib.pa_proves_of_models fun _ _ _ ↦ models_isFuncOR_add.mpr (isFunc_LOR_iff_V.mpr (Or.inr (Or.inr (Or.inl ⟨rfl, rfl⟩))))
theorem lib_isFuncOR_add : Lib isFuncOR_add := Lib.of_pa pa_proves_isFuncOR_add

/-- `(ℒₒᵣ).IsFunc 2 1` (`*`). -/
noncomputable def isFuncOR_mulB : ArithmeticSemisentence 0 := “!(ℒₒᵣ).isFunc (0 + 1 + 1) (0 + 1)”
noncomputable def isFuncOR_mul : ArithmeticSentence := ∀¹* isFuncOR_mulB
lemma models_isFuncOR_mul : V↓[ℒₒᵣ] ⊧ isFuncOR_mul ↔ (ℒₒᵣ).IsFunc (2 : V) 1 := by
  simp [isFuncOR_mul, isFuncOR_mulB, models_iff]; norm_num
theorem pa_proves_isFuncOR_mul : 𝗣𝗔 ⊢ isFuncOR_mul :=
  Lib.pa_proves_of_models fun _ _ _ ↦ models_isFuncOR_mul.mpr (isFunc_LOR_iff_V.mpr (Or.inr (Or.inr (Or.inr ⟨rfl, rfl⟩))))
theorem lib_isFuncOR_mul : Lib isFuncOR_mul := Lib.of_pa pa_proves_isFuncOR_mul

/-- `(ℒₒᵣ).IsRel 2 0` (`=`). -/
noncomputable def isRelOR_eqB : ArithmeticSemisentence 0 := “!(ℒₒᵣ).isRel (0 + 1 + 1) 0”
noncomputable def isRelOR_eq : ArithmeticSentence := ∀¹* isRelOR_eqB
lemma models_isRelOR_eq : V↓[ℒₒᵣ] ⊧ isRelOR_eq ↔ (ℒₒᵣ).IsRel (2 : V) 0 := by
  simp [isRelOR_eq, isRelOR_eqB, models_iff]; norm_num
theorem pa_proves_isRelOR_eq : 𝗣𝗔 ⊢ isRelOR_eq :=
  Lib.pa_proves_of_models fun _ _ _ ↦ models_isRelOR_eq.mpr (isRel_LOR_iff_V.mpr (Or.inl ⟨rfl, rfl⟩))
theorem lib_isRelOR_eq : Lib isRelOR_eq := Lib.of_pa pa_proves_isRelOR_eq

/-- `(ℒₒᵣ).IsRel 2 1` (`<`). -/
noncomputable def isRelOR_ltB : ArithmeticSemisentence 0 := “!(ℒₒᵣ).isRel (0 + 1 + 1) (0 + 1)”
noncomputable def isRelOR_lt : ArithmeticSentence := ∀¹* isRelOR_ltB
lemma models_isRelOR_lt : V↓[ℒₒᵣ] ⊧ isRelOR_lt ↔ (ℒₒᵣ).IsRel (2 : V) 1 := by
  simp [isRelOR_lt, isRelOR_ltB, models_iff]; norm_num
theorem pa_proves_isRelOR_lt : 𝗣𝗔 ⊢ isRelOR_lt :=
  Lib.pa_proves_of_models fun _ _ _ ↦ models_isRelOR_lt.mpr (isRel_LOR_iff_V.mpr (Or.inr ⟨rfl, rfl⟩))
theorem lib_isRelOR_lt : Lib isRelOR_lt := Lib.of_pa pa_proves_isRelOR_lt

end indRecPre
