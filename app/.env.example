# Copy to `app/.env` (gitignored) and fill in. Loaded automatically when
# pd_runner is imported — see src/pd_runner/dotenv.py. Real environment
# variables take precedence, so `ANTHROPIC_API_KEY=... uv run ...` overrides.
#
# Required by the proof/bot agents. Do NOT export this from your shell rc
# file: a global export is inherited by other tools (notably Claude Code),
# which then bill the API account instead of your subscription.
ANTHROPIC_API_KEY=

# Unused today — placeholder for future non-Anthropic provider support.
OPENAI_API_KEY=

# Optional override if your Lean project folder is not ../code
PD_LEAN_CODE_DIR=
