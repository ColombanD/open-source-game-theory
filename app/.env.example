# Copy to `app/.env` (gitignored) and fill in. Loaded automatically when
# pd_runner is imported — see src/pd_runner/dotenv.py. Real environment
# variables take precedence, so `ANTHROPIC_API_KEY=... uv run ...` overrides.
#
# Required by the proof/bot agents. Do NOT export this from your shell rc
# file: a global export is inherited by other tools (notably Claude Code),
# which then bill the API account instead of your subscription.
ANTHROPIC_API_KEY=

# Non-Anthropic models (--model leanstral-1-5, ...) route through the
# OpenAI-compatible client (llm/openai_client.py); providers are declared in
# settings.OPENAI_COMPAT_PROVIDERS. Leanstral 1.5's hosted endpoint is free —
# create a key at console.mistral.ai.
MISTRAL_API_KEY=

# Self-hosted escape hatch: point ANY non-claude model name at an
# OpenAI-compatible server (e.g. vLLM). Overrides the provider registry.
# PD_OPENAI_BASE_URL=http://localhost:8000/v1
# PD_OPENAI_API_KEY=

# Optional override if your Lean project folder is not ../code
PD_LEAN_CODE_DIR=
